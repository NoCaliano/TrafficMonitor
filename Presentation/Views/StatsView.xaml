<UserControl x:Class="Presentation.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="clr-namespace:Presentation.Helpers"
             xmlns:models="clr-namespace:Presentation.Models"
             mc:Ignorable="d">
    <UserControl.Resources>
        <helpers:ProcessIconConverter x:Key="ProcessIconConverter"/>

        <Style x:Key="StatsSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource ViewTitleTextStyle}">
            <Setter Property="FontSize" Value="17"/>
        </Style>

        <Style x:Key="ThinProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Foreground" Value="#FFF2B400"/>
            <Setter Property="Background" Value="{StaticResource AccentBrushSoft}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10" Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Top Processes" Style="{StaticResource StatsSectionTitleStyle}"/>
                        <TextBlock Text="Applications ranked by total traffic usage" Style="{StaticResource SectionCaptionTextStyle}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding TopProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ProcessTrafficRow}">
                                    <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.RowSpan="2"
                                                    Width="34"
                                                    Height="34"
                                                    Margin="0,0,10,0"
                                                    CornerRadius="8"
                                                    Background="{StaticResource CardAltBrush}"
                                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                                    BorderThickness="1">
                                                <Image Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Image.Source>
                                                        <Binding Path="Pid" Converter="{StaticResource ProcessIconConverter}"/>
                                                    </Image.Source>
                                                </Image>
                                            </Border>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding BytesLabel}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Top"
                                                       Margin="10,0,0,0"/>

                                            <ProgressBar Grid.Row="1"
                                                         Grid.Column="1"
                                                         Grid.ColumnSpan="2"
                                                         Style="{StaticResource ThinProgressBarStyle}"
                                                         Value="{Binding RelativePercent}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SectionCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Top Hosts" Style="{StaticResource StatsSectionTitleStyle}"/>
                        <TextBlock Text="Remote hosts sorted by consumed traffic" Style="{StaticResource SectionCaptionTextStyle}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding TopHosts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:HostStatRow}">
                                    <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.RowSpan="2"
                                                    Width="34"
                                                    Height="34"
                                                    Margin="0,0,10,0"
                                                    CornerRadius="8"
                                                    Background="{StaticResource CardAltBrush}"
                                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                                    BorderThickness="1">
                                                <TextBlock Text="{Binding BadgeText}"
                                                           FontWeight="SemiBold"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </Border>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding BytesLabel}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Top"
                                                       Margin="10,0,0,0"/>

                                            <ProgressBar Grid.Row="1"
                                                         Grid.Column="1"
                                                         Grid.ColumnSpan="2"
                                                         Style="{StaticResource ThinProgressBarStyle}"
                                                         Value="{Binding RelativePercent}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource SectionCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Top Traffic Types" Style="{StaticResource StatsSectionTitleStyle}"/>
                        <TextBlock Text="Protocol and service buckets by traffic volume" Style="{StaticResource SectionCaptionTextStyle}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding TopTrafficTypes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:TrafficTypeStatRow}">
                                    <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.RowSpan="2"
                                                    Width="34"
                                                    Height="34"
                                                    Margin="0,0,10,0"
                                                    CornerRadius="8"
                                                    Background="{StaticResource CardAltBrush}"
                                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                                    BorderThickness="1">
                                                <TextBlock Text="{Binding BadgeText}"
                                                           FontWeight="SemiBold"
                                                           FontSize="10"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </Border>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding BytesLabel}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Top"
                                                       Margin="10,0,0,0"/>

                                            <ProgressBar Grid.Row="1"
                                                         Grid.Column="1"
                                                         Grid.ColumnSpan="2"
                                                         Style="{StaticResource ThinProgressBarStyle}"
                                                         Value="{Binding RelativePercent}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="6" Style="{StaticResource SectionCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Top Conversations" Style="{StaticResource StatsSectionTitleStyle}"/>
                        <TextBlock Text="Largest process-to-remote conversations by traffic volume" Style="{StaticResource SectionCaptionTextStyle}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding TopConversations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ConversationTrafficRow}">
                                    <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.RowSpan="3"
                                                    Width="34"
                                                    Height="34"
                                                    Margin="0,0,10,0"
                                                    CornerRadius="8"
                                                    Background="{StaticResource CardAltBrush}"
                                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                                    BorderThickness="1">
                                                <Image Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Image.Source>
                                                        <Binding Path="Pid" Converter="{StaticResource ProcessIconConverter}"/>
                                                    </Image.Source>
                                                </Image>
                                            </Border>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Row="2" Text="{Binding PacketCountLabel}" Style="{StaticResource MutedTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding BytesLabel}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Top"
                                                       Margin="10,0,0,0"/>

                                            <ProgressBar Grid.Row="2"
                                                         Grid.Column="1"
                                                         Grid.ColumnSpan="2"
                                                         Style="{StaticResource ThinProgressBarStyle}"
                                                         Value="{Binding RelativePercent}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Capture Summary" Style="{StaticResource StatsSectionTitleStyle}"/>
                    <TextBlock Text="Overall traffic snapshot for the current capture" Style="{StaticResource SectionCaptionTextStyle}" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding SummaryTotalBytesHuman}" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SummaryTotalPackets, StringFormat={}{0:N0} packets}" Style="{StaticResource MutedTextBlockStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding SummaryBytesPerSec}" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SummaryPacketsPerSec}" Style="{StaticResource MutedTextBlockStyle}"/>
                </StackPanel>

                <CheckBox Grid.Column="3"
                          Content="Hide multicast / broadcast"
                          IsChecked="{Binding HideMulticastBroadcast}"
                          VerticalAlignment="Center"
                          Margin="18,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
