<UserControl x:Class="Presentation.Views.ProcessPacketsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:Presentation.Helpers"
             xmlns:local="clr-namespace:Presentation.Helpers"
             xmlns:models="clr-namespace:Presentation.Models">
    <UserControl.Resources>
        <local:ProcessIconConverter x:Key="ProcessIconConverter"/>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <Style x:Key="ProcessCardStyle" TargetType="Border" BasedOn="{StaticResource SectionCardStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushStrong}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsAlive}" Value="False">
                    <Setter Property="Opacity" Value="0.7"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ProcessTimelineDetailsTemplate" DataType="{x:Type models:ProcessStatRow}">
            <StackPanel>
                <TextBlock Text="{Binding DisplayName}"
                           FontWeight="SemiBold"
                           FontSize="14"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           TextWrapping="Wrap"/>

                <TextBlock Margin="0,4,0,0"
                           Text="{Binding RiskLabel}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{Binding RiskBrush}"/>

                <WrapPanel Margin="0,12,0,0">
                    <TextBlock Margin="0,0,14,6" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="{Binding PacketCount, StringFormat=Packets: {0:N0}}"/>
                    <TextBlock Margin="0,0,14,6" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="{Binding TotalBytesHuman, StringFormat=Traffic: {0}}"/>
                    <TextBlock Margin="0,0,14,6" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="{Binding DistinctRemoteEndpoints, StringFormat=Remotes: {0}}"/>
                    <TextBlock Margin="0,0,14,6" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="{Binding LastSeenLabel}"/>
                </WrapPanel>

                <TextBlock Margin="0,14,0,0"
                           Text="{Binding TimelineTitle}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <ItemsControl ItemsSource="{Binding TimelineEvents}" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="68"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding TimeLabel}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding DateLabel}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>

                                <Grid Grid.Column="1" HorizontalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Top"/>
                                    <Rectangle Grid.Row="1" Width="1" Fill="{StaticResource BorderBrushSoft}" Margin="0,6,0,0"/>
                                </Grid>

                                <Border Grid.Column="2"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Margin="0,4,0,0" Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Margin="0,8,0,0"
                           Text="{Binding TimelineEmptyState}"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="Wrap"/>

                <TextBlock Margin="0,18,0,0"
                           Text="{Binding ConversationTitle}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <ItemsControl ItemsSource="{Binding Conversations}" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10"
                                    Padding="10,8"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding ConversationLabel}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap"/>
                                        <WrapPanel Margin="0,4,0,0">
                                            <TextBlock Margin="0,0,12,4" Text="{Binding PacketCountLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Margin="0,0,12,4" Text="{Binding BytesLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Margin="0,0,12,4" Text="{Binding DirectionLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        </WrapPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding LastSeenLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding FirstSeenLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Margin="0,2,0,0"
                           Text="{Binding ConversationEmptyState}"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="Wrap"/>

                <TextBlock Margin="0,18,0,0"
                           Text="{Binding SessionClustersTitle}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <ItemsControl ItemsSource="{Binding SessionClusters}" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10"
                                    Padding="10,8"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <WrapPanel Margin="0,4,0,0">
                                            <TextBlock Margin="0,0,12,4" Text="{Binding PacketCountLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Margin="0,0,12,4" Text="{Binding BytesLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Margin="0,0,12,4" Text="{Binding DirectionLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        </WrapPanel>
                                        <TextBlock Margin="0,4,0,0" Text="{Binding RemoteSummaryLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding WindowLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding DurationLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Margin="0,2,0,0"
                           Text="{Binding SessionClustersEmptyState}"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="ProcessPacketsLayout" Background="{StaticResource AppBackgroundBrush}" DataContext="{Binding ProcessPackets}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}">
            <ListBox ItemsSource="{Binding ProcessStatsView}"
                     SelectedItem="{Binding SelectedProcessStat}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="6"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ProcessCardStyle}" MinHeight="250">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" LastChildFill="True">
                                    <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="8" Margin="0,0,10,0" Background="{StaticResource CardAltBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
                                        <Image Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Image.Source>
                                                <Binding Path="Pid" Converter="{StaticResource ProcessIconConverter}"/>
                                            </Image.Source>
                                        </Image>
                                    </Border>

                                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding LivenessLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding LivenessBrush}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding RiskLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding RiskBrush}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding SignedLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="{Binding Pid, StringFormat=PID: {0}}"/>
                                    </StackPanel>
                                </DockPanel>

                                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Text="{Binding Publisher, StringFormat=Publisher: {0}}"/>
                                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExePath}" Text="{Binding ExePath, StringFormat=Path: {0}}"/>
                                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Text="{Binding ParentDisplay}"/>
                                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Text="{Binding LastSeenLabel}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="{Binding PacketCount, StringFormat=Packets: {0:N0}}"/>
                                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="12,0,0,0" Text="{Binding TotalBytesHuman, StringFormat=Traffic: {0}}"/>
                                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="12,0,0,0" Text="{Binding DistinctRemoteEndpoints, StringFormat=Remotes: {0}}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,4,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="{Binding LastSamplePackets, StringFormat=Recent: {0} pkt}"/>
                                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="12,0,0,0" Text="{Binding PeakSamplePackets, StringFormat=Peak: {0} pkt}"/>
                                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="12,0,0,0" Text="{Binding AvgSamplePackets, StringFormat=Avg: {0:0.#} pkt}"/>
                                    </StackPanel>

                                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Text="{Binding TopRemoteEndpoint, StringFormat=Top: {0}}"/>
                                    <TextBlock Foreground="{Binding RiskBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Text="{Binding BeaconLabel}"/>
                                </StackPanel>

                                <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" Padding="8" Margin="0,10,0,0" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
                                    <StackPanel>
                                        <DockPanel LastChildFill="True">
                                            <TextBlock Text="{Binding WhyFlaggedLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding RiskScore, StringFormat={}{0}/100}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding RiskBrush}"/>
                                        </DockPanel>

                                        <ItemsControl ItemsSource="{Binding RiskReasons}"
                                                      Margin="0,4,0,0"
                                                      Visibility="{Binding HasRiskReasons, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,4,0,0" LastChildFill="True">
                                                        <Border DockPanel.Dock="Right"
                                                                Background="{StaticResource CardAltBrush}"
                                                                BorderBrush="{StaticResource BorderBrushSoft}"
                                                                BorderThickness="1"
                                                                CornerRadius="10"
                                                                Padding="6,1"
                                                                Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding PointsLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        </Border>

                                                        <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Margin="0,4,0,0" Text="{Binding RiskEmptyState}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="5" Background="{StaticResource SurfaceBrush}" Padding="6" Margin="0,10,0,0" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
                                    <Grid Height="44">
                                        <Rectangle Fill="{StaticResource CardAltBrush}" RadiusX="6" RadiusY="6"/>
                                        <Viewbox Stretch="Fill">
                                            <Canvas Width="180" Height="24">
                                                <Path Data="{Binding SparklineGeometry}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                </Border>

                                <WrapPanel Grid.Row="6" Margin="0,10,0,0" HorizontalAlignment="Right">
                                    <Button Content="Locate"
                                            Command="{Binding DataContext.LocateProcessCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding Pid}"
                                            Style="{StaticResource ChipButtonStyle}"
                                            Margin="0,0,6,6"/>
                                    <Button Content="Block"
                                            Command="{Binding DataContext.BlockProcessFirewallCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding Pid}"
                                            Style="{StaticResource ChipButtonStyle}"
                                            Margin="0,0,6,6"/>
                                    <Button Content="Unblock"
                                            Command="{Binding DataContext.UnblockProcessFirewallCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding Pid}"
                                            Style="{StaticResource ChipButtonStyle}"
                                            Margin="0,0,6,6"/>
                                    <Button Content="Kill"
                                            Command="{Binding DataContext.KillProcessCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding Pid}"
                                            Style="{StaticResource ChipButtonStyle}"
                                            Margin="0,0,6,6"/>
                                    <Button Content="Show"
                                            Command="{Binding DataContext.ShowPacketsForPidCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding Pid}"
                                            Style="{StaticResource ChipButtonStyle}"
                                            Margin="0,0,6,6"/>
                                    <Button Content="Focus"
                                            Command="{Binding DataContext.FocusOnPidCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding Pid}"
                                            Style="{StaticResource ChipButtonStyle}"
                                            Margin="0,0,0,6"/>
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <Border Grid.Column="2" Margin="12,0,0,0" Style="{StaticResource SectionCardStyle}">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Investigation timeline" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Margin="0,10,0,0">
                    <Grid>
                        <StackPanel Visibility="{Binding DataContext.SelectedProcessStat, ElementName=ProcessPacketsLayout, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Foreground="{StaticResource TextMutedBrush}" Text="No process selected."/>
                            <TextBlock Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" Text="Select a process card to inspect its timeline."/>
                        </StackPanel>

                        <ContentPresenter Content="{Binding DataContext.SelectedProcessStat, ElementName=ProcessPacketsLayout}"
                                          ContentTemplate="{StaticResource ProcessTimelineDetailsTemplate}"
                                          Visibility="{Binding DataContext.SelectedProcessStat, ElementName=ProcessPacketsLayout, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
