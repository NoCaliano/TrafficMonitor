<UserControl x:Class="Presentation.Views.ProcessPacketsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:Presentation.Helpers"
             xmlns:local="clr-namespace:Presentation.Helpers">
    <UserControl.Resources>
        <!-- Converter to get process icon from PID -->
        <local:ProcessIconConverter x:Key="ProcessIconConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="260"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="8" Background="#FFF" BorderBrush="#FFE6E6E6" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Processes (discovered)" FontWeight="Bold" FontSize="14"/>
                <TextBlock Text="  —  "/>
                <TextBlock Text="Shows processes that own sockets and their packet counts" Foreground="#666" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding ProcessStats}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  RowHeight="48"
                  HeadersVisibility="Column"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  Margin="8">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="56">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Width="32" Height="32" CornerRadius="4">
                                <Image Width="32" Height="32">
                                    <Image.Source>
                                        <Binding Path="Pid" Converter="{StaticResource ProcessIconConverter}" />
                                    </Image.Source>
                                </Image>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Process (PID)" Binding="{Binding DisplayName}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Packets" Binding="{Binding PacketCount}" Width="120"/>
                <DataGridTextColumn Header="Traffic (MB)" Binding="{Binding TrafficMb, StringFormat=N2}" Width="140"/>

                <DataGridTemplateColumn Header="Chart" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- Placeholder for small sparkline chart -->
                            <Border Background="#FFF" Padding="4">
                                <Grid Height="32">
                                    <Rectangle Fill="#F5F5F5" RadiusX="3" RadiusY="3"/>
                                    <Viewbox Stretch="Fill">
                                        <Canvas Width="180" Height="24">
                                            <Path Data="{Binding SparklineGeometry}" Stroke="#007ACC" StrokeThickness="1.5" />
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Actions" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Show Packets"
                                        Command="{Binding DataContext.ShowPacketsForPidCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Pid}" Margin="0,0,6,0"/>
                                <Button Content="Focus" Width="48"
                                        Command="{Binding DataContext.FocusOnPidCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Pid}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch"/>
    </Grid>
</UserControl>