<UserControl x:Class="Presentation.Views.ProcessPacketsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:Presentation.Helpers"
             xmlns:local="clr-namespace:Presentation.Helpers">
    <UserControl.Resources>
        <!-- Converter to get process icon from PID -->
        <local:ProcessIconConverter x:Key="ProcessIconConverter"/>

        <Style x:Key="ProcessCardStyle" TargetType="Border" BasedOn="{StaticResource SectionCardStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushStrong}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsAlive}" Value="False">
                    <Setter Property="Opacity" Value="0.7"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="10"
                      PanningMode="VerticalOnly">
            <ItemsControl ItemsSource="{Binding ProcessStatsView}">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="6"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ProcessCardStyle}" MinHeight="170">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                     <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" LastChildFill="True">
                                    <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="8" Margin="0,0,10,0" Background="{StaticResource CardAltBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
                                        <Image Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Image.Source>
                                                <Binding Path="Pid" Converter="{StaticResource ProcessIconConverter}" />
                                            </Image.Source>
                                        </Image>
                                    </Border>

                                     <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                         <TextBlock Text="{Binding LivenessLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding LivenessBrush}" HorizontalAlignment="Right"/>
                                         <TextBlock Text="{Binding RiskLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding RiskBrush}" HorizontalAlignment="Right"/>
                                         <TextBlock Text="{Binding SignedLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                     </StackPanel>

                                    <StackPanel>
                                        <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="{Binding Pid, StringFormat=PID: {0}}"/>
                                    </StackPanel>
                                </DockPanel>

                                 <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                     <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Text="{Binding Publisher, StringFormat=Publisher: {0}}"/>
                                     <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExePath}" Text="{Binding ExePath, StringFormat=Path: {0}}"/>
                                     <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Text="{Binding ParentDisplay}"/>
                                     <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Text="{Binding LastSeenLabel}"/>
                                 </StackPanel>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="{Binding PacketCount, StringFormat=Packets: {0:N0}}"/>
                                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="12,0,0,0" Text="{Binding TotalBytesHuman, StringFormat=Traffic: {0}}"/>
                                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="12,0,0,0" Text="{Binding DistinctRemoteEndpoints, StringFormat=Remotes: {0}}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,4,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="{Binding LastSamplePackets, StringFormat=Recent: {0} pkt}"/>
                                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="12,0,0,0" Text="{Binding PeakSamplePackets, StringFormat=Peak: {0} pkt}"/>
                                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="12,0,0,0" Text="{Binding AvgSamplePackets, StringFormat=Avg: {0:0.#} pkt}"/>
                                    </StackPanel>

                                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Text="{Binding TopRemoteEndpoint, StringFormat=Top: {0}}"/>
                                    <TextBlock Foreground="{Binding RiskBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Text="{Binding BeaconLabel}"/>
                                </StackPanel>

                                 <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" Padding="6" Margin="0,10,0,0" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
                                    <Grid Height="44">
                                        <Rectangle Fill="{StaticResource CardAltBrush}" RadiusX="6" RadiusY="6"/>
                                        <Viewbox Stretch="Fill">
                                            <Canvas Width="180" Height="24">
                                                <Path Data="{Binding SparklineGeometry}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                </Border>

                                 <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
                                    <Button Content="Locate"
                                            Command="{Binding DataContext.LocateProcessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Pid}"
                                            Style="{StaticResource ChipButtonStyle}"
                                            Margin="0,0,6,0"/>
                                    <Button Content="Block"
                                            Command="{Binding DataContext.BlockProcessFirewallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Pid}"
                                            Style="{StaticResource ChipButtonStyle}"
                                            Margin="0,0,6,0"/>
                                    <Button Content="Unblock"
                                            Command="{Binding DataContext.UnblockProcessFirewallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Pid}"
                                            Style="{StaticResource ChipButtonStyle}"
                                            Margin="0,0,6,0"/>
                                    <Button Content="Kill"
                                            Command="{Binding DataContext.KillProcessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Pid}"
                                            Style="{StaticResource ChipButtonStyle}"
                                            Margin="0,0,6,0"/>
                                    <Button Content="Show"
                                            Command="{Binding DataContext.ShowPacketsForPidCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Pid}"
                                            Style="{StaticResource ChipButtonStyle}"
                                            Margin="0,0,6,0"/>
                                    <Button Content="Focus"
                                            Command="{Binding DataContext.FocusOnPidCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Pid}"
                                            Style="{StaticResource ChipButtonStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
