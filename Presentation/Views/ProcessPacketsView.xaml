<UserControl x:Class="Presentation.Views.ProcessPacketsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:Presentation.Helpers"
             xmlns:local="clr-namespace:Presentation.Helpers"
             xmlns:models="clr-namespace:Presentation.Models"
             PreviewMouseUp="OnPreviewMouseUp">
    <UserControl.Resources>
        <local:ProcessIconConverter x:Key="ProcessIconConverter"/>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <Style x:Key="ProcessCardStyle" TargetType="Border" BasedOn="{StaticResource SectionCardStyle}">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushStrong}"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Effect" Value="{x:Null}"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                        <Condition Binding="{Binding IsSelectedInProcessGrid}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushStrong}"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsAlive}" Value="False">
                    <Setter Property="Background" Value="{StaticResource CardAltBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
                    <Setter Property="Opacity" Value="0.8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelectedInProcessGrid}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="BorderThickness" Value="1.8"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProcessFilterChipStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chip"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource BorderBrushStrong}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource AccentBrushSoft}"/>
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProcessActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ChipButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>

        <Style x:Key="ProcessActionArrowToggleStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="MinWidth" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ArrowBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0,10,10,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ArrowBorder" Property="BorderBrush" Value="{StaticResource BorderBrushStrong}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ArrowBorder" Property="Background" Value="{StaticResource AccentBrushSoft}"/>
                                <Setter TargetName="ArrowBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProcessPopupActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <DataTemplate x:Key="ProcessTimelineDetailsTemplate" DataType="{x:Type models:ProcessStatRow}">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0"
                            Grid.Column="0"
                            Content="Open folder"
                            Command="{Binding DataContext.LocateProcessCommand, ElementName=ProcessPacketsLayout}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource ProcessActionButtonStyle}"/>

                    <Grid Grid.Row="0"
                          Grid.Column="1"
                          x:Name="BlockActionsAnchor"
                          Margin="0,0,6,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Block network"
                                Command="{Binding DataContext.BlockProcessFirewallCommand, ElementName=ProcessPacketsLayout}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource ProcessActionButtonStyle}"
                                Margin="0"/>

                        <ToggleButton Grid.Column="1"
                                      Content="▾"
                                      IsChecked="{Binding DataContext.IsBlockPresetMenuOpen, ElementName=ProcessPacketsLayout, Mode=TwoWay}"
                                      Style="{StaticResource ProcessActionArrowToggleStyle}"
                                      Margin="0"/>

                        <Popup PlacementTarget="{Binding ElementName=BlockActionsAnchor}"
                               Placement="Bottom"
                               HorizontalOffset="0"
                               VerticalOffset="6"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               StaysOpen="False"
                               IsOpen="{Binding DataContext.IsBlockPresetMenuOpen, ElementName=ProcessPacketsLayout, Mode=TwoWay}">
                            <Border Width="220"
                                    Padding="8"
                                    Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    SnapsToDevicePixels="True">
                                <StackPanel>
                                    <Button Content="Block permanently"
                                            Command="{Binding DataContext.BlockProcessFirewallCommand, ElementName=ProcessPacketsLayout}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource ProcessPopupActionButtonStyle}"/>
                                    <Button Content="Block for 15 min"
                                            Command="{Binding DataContext.BlockProcessFirewallFor15MinutesCommand, ElementName=ProcessPacketsLayout}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource ProcessPopupActionButtonStyle}"/>
                                    <Button Content="Block for 1 hour"
                                            Command="{Binding DataContext.BlockProcessFirewallFor1HourCommand, ElementName=ProcessPacketsLayout}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource ProcessPopupActionButtonStyle}"/>
                                    <Button Content="Block until app exit"
                                            Command="{Binding DataContext.BlockProcessFirewallUntilAppExitCommand, ElementName=ProcessPacketsLayout}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource ProcessPopupActionButtonStyle}"
                                            Margin="0"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <Button Grid.Row="0"
                            Grid.Column="2"
                            Content="Restore network"
                            Command="{Binding DataContext.UnblockProcessFirewallCommand, ElementName=ProcessPacketsLayout}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource ProcessActionButtonStyle}"
                            Margin="0,0,0,6"/>

                    <Button Grid.Row="1"
                            Grid.Column="0"
                            Content="End process"
                            Command="{Binding DataContext.KillProcessCommand, ElementName=ProcessPacketsLayout}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource ProcessActionButtonStyle}"
                            Margin="0,0,6,0"/>
                    <Button Grid.Row="1"
                            Grid.Column="1"
                            Content="Show packets"
                            Command="{Binding DataContext.ShowPacketsForPidCommand, ElementName=ProcessPacketsLayout}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource ProcessActionButtonStyle}"
                            Margin="0,0,6,0"/>
                    <Button Grid.Row="1"
                            Grid.Column="2"
                            Content="Export report"
                            Command="{Binding DataContext.ExportIncidentReportCommand, ElementName=ProcessPacketsLayout}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource ProcessActionButtonStyle}"
                            Margin="0"/>
                </Grid>

                <TextBlock Margin="0,4,0,0"
                           Text="{Binding DetectionScenariosTitle}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <ItemsControl ItemsSource="{Binding DetectionScenarios}" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10"
                                    Padding="10,8"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel>
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Right"
                                                Background="{StaticResource CardAltBrush}"
                                                BorderBrush="{Binding ConfidenceBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="8,2"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding ConfidenceBadge}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding ConfidenceBrush}"/>
                                        </Border>

                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding MitreDisplayLabel}"
                                                       Margin="0,2,0,0"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <TextBlock Margin="0,6,0,0"
                                               Text="{Binding Summary}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Margin="0,8,0,0"
                                               Text="{Binding ConfidenceLabel}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding ConfidenceBrush}"/>

                                    <ItemsControl ItemsSource="{Binding Evidence}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,0,0,4" LastChildFill="True">
                                                    <TextBlock DockPanel.Dock="Left"
                                                               Text="•"
                                                               Margin="0,0,6,0"
                                                               Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding Summary}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               TextWrapping="Wrap"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Margin="0,2,0,0"
                           Text="{Binding DetectionScenariosEmptyState}"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="Wrap"/>

                <TextBlock Margin="0,14,0,0"
                           Text="{Binding TlsDnsInsightsTitle}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <ItemsControl ItemsSource="{Binding TlsDnsInsights}" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10"
                                    Padding="10,8"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel>
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Right"
                                                Background="{StaticResource CardAltBrush}"
                                                BorderBrush="{Binding SeverityBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="8,2"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding ScoreLabel}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding SeverityBrush}"/>
                                        </Border>

                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding SeverityLabel}"
                                                       Margin="0,2,0,0"
                                                       FontSize="10"
                                                       Foreground="{Binding SeverityBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <TextBlock Margin="0,6,0,0"
                                               Text="{Binding Summary}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               TextWrapping="Wrap"/>

                                    <ItemsControl ItemsSource="{Binding Evidence}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,0,0,4" LastChildFill="True">
                                                    <TextBlock DockPanel.Dock="Left"
                                                               Text="-"
                                                               Margin="0,0,6,0"
                                                               Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding Summary}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               TextWrapping="Wrap"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Margin="0,2,0,0"
                           Text="{Binding TlsDnsInsightsEmptyState}"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="Wrap"/>

                <TextBlock Margin="0,14,0,0"
                           Text="{Binding BehaviorDeviationsTitle}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <Border Margin="0,10,0,0"
                        Padding="10,8"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="{Binding BaselineStateLabel}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Margin="0,6,0,0"
                                   Text="{Binding BaselineSummary}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Margin="0,6,0,0"
                                   Text="{Binding BaselineLearningNote}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding BehaviorDeviations}" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10"
                                    Padding="10,8"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel>
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Right"
                                                Background="{StaticResource CardAltBrush}"
                                                BorderBrush="{Binding SeverityBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="8,2"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding ScoreLabel}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding SeverityBrush}"/>
                                        </Border>

                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding SeverityLabel}"
                                                       Margin="0,2,0,0"
                                                       FontSize="10"
                                                       Foreground="{Binding SeverityBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <TextBlock Margin="0,6,0,0"
                                               Text="{Binding Summary}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               TextWrapping="Wrap"/>

                                    <ItemsControl ItemsSource="{Binding Evidence}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,0,0,4" LastChildFill="True">
                                                    <TextBlock DockPanel.Dock="Left"
                                                               Text="-"
                                                               Margin="0,0,6,0"
                                                               Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding Summary}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               TextWrapping="Wrap"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Margin="0,2,0,0"
                           Text="{Binding BehaviorDeviationsEmptyState}"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="Wrap"/>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Incident graph"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            Margin="12,0,0,0"
                            Padding="10,4"
                            MinHeight="28"
                            Content="🖼 Save image"
                            Command="{Binding DataContext.SaveIncidentGraphImageCommand, ElementName=ProcessPacketsLayout}"
                            CommandParameter="{Binding ElementName=IncidentGraphExportContent}"
                            ToolTip="Save incident graph as PNG"
                            Visibility="{Binding DataContext.SelectedIncidentGraph.HasGraph, ElementName=ProcessPacketsLayout, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>

                <TextBlock Margin="0,4,0,0"
                           Text="{Binding DataContext.SelectedIncidentGraph.SummaryLabel, ElementName=ProcessPacketsLayout}"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="Wrap"/>

                <Border x:Name="IncidentGraphExportSurface"
                        Margin="0,10,0,0"
                        Padding="12"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Visibility="{Binding DataContext.SelectedIncidentGraph.HasGraph, ElementName=ProcessPacketsLayout, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Viewbox Stretch="Uniform"
                             StretchDirection="DownOnly"
                             HorizontalAlignment="Center">
                        <StackPanel x:Name="IncidentGraphExportContent">
                            <ItemsControl ItemsSource="{Binding DataContext.SelectedIncidentGraph.Lanes, ElementName=ProcessPacketsLayout}">
                                <ItemsControl.Width>
                                    <Binding Path="DataContext.SelectedIncidentGraph.CanvasWidth" ElementName="ProcessPacketsLayout"/>
                                </ItemsControl.Width>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ProcessIncidentGraphLane}">
                                        <Border Width="{Binding Width}"
                                                Margin="4,0"
                                                Padding="8,4"
                                                Background="{StaticResource CardAltBrush}"
                                                CornerRadius="8">
                                            <TextBlock Text="{Binding Label}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Margin="0,10,0,0"
                                    Background="{StaticResource CardAltBrush}"
                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10">
                                <Grid Width="{Binding DataContext.SelectedIncidentGraph.CanvasWidth, ElementName=ProcessPacketsLayout}"
                                      Height="{Binding DataContext.SelectedIncidentGraph.CanvasHeight, ElementName=ProcessPacketsLayout}">
                                    <ItemsControl ItemsSource="{Binding DataContext.SelectedIncidentGraph.Edges, ElementName=ProcessPacketsLayout}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Path Data="{Binding Geometry}"
                                                      Stroke="{Binding Stroke}"
                                                      StrokeDashArray="{Binding StrokeDashArray}"
                                                      StrokeThickness="{Binding Thickness}"
                                                      Opacity="{Binding Opacity}"
                                                      IsHitTestVisible="False"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{Binding DataContext.SelectedIncidentGraph.Nodes, ElementName=ProcessPacketsLayout}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                                <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                                <Setter Property="Panel.ZIndex" Value="1"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="{Binding Width}"
                                                        Height="{Binding Height}"
                                                        Padding="12,10"
                                                        Background="{Binding BackgroundBrush}"
                                                        BorderBrush="{Binding BorderBrush}"
                                                        BorderThickness="1.4"
                                                        CornerRadius="10"
                                                        ToolTipService.InitialShowDelay="180"
                                                        ToolTipService.ShowDuration="30000"
                                                        ToolTip="{Binding Tooltip}">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding KindLabel}"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{Binding AccentBrush}"
                                                                       VerticalAlignment="Center"/>
                                                            <Border Grid.Column="1"
                                                                    Padding="6,1"
                                                                    Margin="8,0,0,0"
                                                                    CornerRadius="7"
                                                                    Background="{Binding BadgeBackgroundBrush}"
                                                                    BorderBrush="{Binding BadgeBorderBrush}"
                                                                    BorderThickness="1"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Text="{Binding BadgeText}"
                                                                           FontSize="9"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{Binding BadgeForegroundBrush}"/>
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock Margin="0,4,0,0"
                                                                   Text="{Binding Title}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding BorderBrush}"
                                                                   TextWrapping="Wrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxHeight="34"/>
                                                        <TextBlock Margin="0,3,0,0"
                                                                   Text="{Binding Subtitle}"
                                                                   FontSize="10"
                                                                   Foreground="{Binding SecondaryBrush}"
                                                                   TextWrapping="Wrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxHeight="24"
                                                                   Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <TextBlock Margin="0,5,0,0"
                                                                   Text="{Binding MetricLabel}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding AccentBrush}"
                                                                   TextWrapping="Wrap"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Viewbox>
                </Border>

                <TextBlock Margin="0,2,0,0"
                           Text="{Binding DataContext.SelectedIncidentGraph.EmptyState, ElementName=ProcessPacketsLayout}"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.SelectedIncidentGraph.HasGraph, ElementName=ProcessPacketsLayout}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Margin="0,14,0,0"
                           Text="{Binding TimelineTitle}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <ItemsControl ItemsSource="{Binding TimelineEvents}" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="68"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding TimeLabel}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding DateLabel}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>

                                <Grid Grid.Column="1" HorizontalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Top"/>
                                    <Rectangle Grid.Row="1" Width="1" Fill="{StaticResource BorderBrushSoft}" Margin="0,6,0,0"/>
                                </Grid>

                                <Border Grid.Column="2"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,8">
                                    <StackPanel>
                                        <DockPanel LastChildFill="True">
                                            <Button DockPanel.Dock="Right"
                                                    Content="{Binding FocusPacketLabel}"
                                                    Command="{Binding DataContext.FocusTimelineEventCommand, ElementName=ProcessPacketsLayout}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource ChipButtonStyle}"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Top"
                                                    Visibility="{Binding CanFocusPacket, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    ToolTip="Show the related packet in the main table"/>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <TextBlock Margin="0,4,0,0" Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Margin="0,8,0,0"
                           Text="{Binding TimelineEmptyState}"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="Wrap"/>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding ConversationTitle}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            Content="{Binding ConversationToggleLabel}"
                            Command="{Binding DataContext.ToggleConversationsExpansionCommand, ElementName=ProcessPacketsLayout}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource ChipButtonStyle}"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding CanToggleConversations, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding VisibleConversations}" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10"
                                    Padding="10,8"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding ConversationLabel}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap"/>
                                        <WrapPanel Margin="0,4,0,0">
                                            <TextBlock Margin="0,0,12,4" Text="{Binding PacketCountLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Margin="0,0,12,4" Text="{Binding BytesLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Margin="0,0,12,4" Text="{Binding DirectionLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        </WrapPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" HorizontalAlignment="Right">
                                        <Button Content="Packets"
                                                Command="{Binding DataContext.ShowPacketsForConversationCommand, ElementName=ProcessPacketsLayout}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ChipButtonStyle}"
                                                HorizontalAlignment="Right"
                                                Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding SeenRangeLabel}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Margin="0,2,0,0"
                           Text="{Binding ConversationEmptyState}"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="Wrap"/>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding SessionClustersTitle}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            Content="{Binding SessionClustersToggleLabel}"
                            Command="{Binding DataContext.ToggleSessionClustersExpansionCommand, ElementName=ProcessPacketsLayout}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource ChipButtonStyle}"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding CanToggleSessionClusters, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding VisibleSessionClusters}" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10"
                                    Padding="10,8"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <WrapPanel Margin="0,4,0,0">
                                            <TextBlock Margin="0,0,12,4" Text="{Binding PacketCountLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Margin="0,0,12,4" Text="{Binding BytesLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Margin="0,0,12,4" Text="{Binding DirectionLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        </WrapPanel>
                                        <TextBlock Margin="0,4,0,0" Text="{Binding RemoteSummaryLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" HorizontalAlignment="Right">
                                        <Button Content="Packets"
                                                Command="{Binding DataContext.ShowPacketsForSessionClusterCommand, ElementName=ProcessPacketsLayout}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ChipButtonStyle}"
                                                HorizontalAlignment="Right"
                                                Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding WindowLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding DurationLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Margin="0,2,0,0"
                           Text="{Binding SessionClustersEmptyState}"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ProcessStatCardTemplate" DataType="{x:Type models:ProcessStatRow}">
            <Border Margin="0,0,10,10"
                    Style="{StaticResource ProcessCardStyle}"
                    MinHeight="210"
                    Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick"
                                  Command="{Binding DataContext.SelectProcessStatCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                  CommandParameter="{Binding}"/>
                </Border.InputBindings>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="True">
                        <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="8" Margin="0,0,10,0" Background="{StaticResource CardAltBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
                            <Image Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Image.Source>
                                    <Binding Path="Pid" Converter="{StaticResource ProcessIconConverter}"/>
                                </Image.Source>
                            </Image>
                        </Border>

                        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding LivenessLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding LivenessBrush}" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding RiskLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding RiskBrush}" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding SignedLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                            <Border Margin="0,6,0,0"
                                    Padding="8,2"
                                    Background="{StaticResource AccentBrushSoft}"
                                    BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    HorizontalAlignment="Right"
                                    Visibility="{Binding HasFirewallBlockBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding FirewallBlockBadgeLabel}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}"/>
                            </Border>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="{Binding Pid, StringFormat=PID: {0}}"/>
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Text="{Binding Publisher, StringFormat=Publisher: {0}}"/>
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExePath}" Text="{Binding ExePath, StringFormat=Path: {0}}"/>
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Text="{Binding ParentDisplay}"/>
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Text="{Binding LastSeenLabel}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="{Binding PacketCount, StringFormat=Packets: {0:N0}}"/>
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="12,0,0,0" Text="{Binding TotalBytesHuman, StringFormat=Traffic: {0}}"/>
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="12,0,0,0" Text="{Binding DistinctRemoteEndpoints, StringFormat=Remotes: {0}}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="{Binding LastSamplePackets, StringFormat=Recent: {0} pkt}"/>
                            <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="12,0,0,0" Text="{Binding PeakSamplePackets, StringFormat=Peak: {0} pkt}"/>
                            <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="12,0,0,0" Text="{Binding AvgSamplePackets, StringFormat=Avg: {0:0.#} pkt}"/>
                        </StackPanel>

                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Text="{Binding TopRemoteEndpoint, StringFormat=Top: {0}}"/>
                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding BaselineStateLabel}"
                                   ToolTip="{Binding BaselineSummary}"
                                   Visibility="{Binding HasBaselineState, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Foreground="{Binding RiskBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Text="{Binding BeaconLabel}"/>
                    </StackPanel>

                    <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" Padding="8" Margin="0,10,0,0" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding WhyFlaggedLabel}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding RiskScore, StringFormat={}{0}/100}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding RiskBrush}"
                                           HorizontalAlignment="Right"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding RiskReasons}"
                                          Margin="0,4,0,0"
                                          Visibility="{Binding HasRiskReasons, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4,0,0" LastChildFill="True">
                                            <Border DockPanel.Dock="Right"
                                                    Background="{StaticResource CardAltBrush}"
                                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="6,1"
                                                    Margin="8,0,0,0">
                                                <TextBlock Text="{Binding PointsLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </Border>

                                            <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Margin="0,4,0,0" Text="{Binding RiskEmptyState}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="5" Background="{StaticResource SurfaceBrush}" Padding="6" Margin="0,10,0,0" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
                        <Grid Height="44">
                            <Rectangle Fill="{StaticResource CardAltBrush}" RadiusX="6" RadiusY="6"/>
                            <Viewbox Stretch="Fill">
                                <Canvas Width="180" Height="24">
                                    <Path Data="{Binding SparklineGeometry}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"/>
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="ProcessPacketsLayout" Background="{StaticResource AppBackgroundBrush}" DataContext="{Binding ProcessPackets}">
        <Border Style="{StaticResource SectionCardStyle}"
                Background="{StaticResource CardAltBrush}"
                BorderBrush="{StaticResource BorderBrushStrong}"
                Visibility="{Binding IsOverviewMode, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <WrapPanel Grid.Column="0">
                            <Border Margin="0,0,8,8"
                                    Padding="10,8"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="Visible" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}">
                                        <Run Text="{Binding VisibleProcessCount, Mode=OneWay}"/>
                                        <Run Text=" / "/>
                                        <Run Text="{Binding TotalProcessCount, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,0,8,8"
                                    Padding="10,8"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="High risk" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding HighRiskProcessCount}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,0,8,8"
                                    Padding="10,8"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="Beacon" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding BeaconProcessCount}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,0,8,8"
                                    Padding="10,8"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="Exited" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding ExitedProcessCount}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,0,0,8"
                                    Padding="10,8"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="Blocked" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding BlockedProcessCount}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <WrapPanel Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top">
                            <ToggleButton Content="High risk"
                                          IsChecked="{Binding ShowHighRiskOnly, Mode=TwoWay}"
                                          Style="{StaticResource ProcessFilterChipStyle}"/>
                            <ToggleButton Content="Beacon"
                                          IsChecked="{Binding ShowBeaconOnly, Mode=TwoWay}"
                                          Style="{StaticResource ProcessFilterChipStyle}"/>
                            <ToggleButton Content="Unsigned"
                                          IsChecked="{Binding ShowUnsignedOnly, Mode=TwoWay}"
                                          Style="{StaticResource ProcessFilterChipStyle}"/>
                            <ToggleButton Content="Exited"
                                          IsChecked="{Binding ShowExitedOnly, Mode=TwoWay}"
                                          Style="{StaticResource ProcessFilterChipStyle}"/>
                            <ToggleButton Content="Blocked"
                                          IsChecked="{Binding ShowBlockedOnly, Mode=TwoWay}"
                                          Style="{StaticResource ProcessFilterChipStyle}"/>
                        </WrapPanel>
                    </Grid>

                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                             MinHeight="28"
                             Padding="8,2"
                             Margin="0,2,0,0"
                             VerticalContentAlignment="Center"
                             ToolTip="Search by process name, publisher, path, top remote, suspicious domain, detection scenario, TLS/DNS intelligence finding, or adaptive baseline deviation"/>
                </StackPanel>

                <ListBox Grid.Row="1"
                         Margin="0,14,0,0"
                         ItemsSource="{Binding VisibleProcessRows}"
                         Background="{StaticResource CardAltBrush}"
                         BorderThickness="0"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         VirtualizingPanel.CacheLength="1"
                         VirtualizingPanel.CacheLengthUnit="Page">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="OverridesDefaultStyle" Value="True"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:ProcessStatCardRow}">
                            <ItemsControl Margin="0,0,-10,0"
                                          ItemsSource="{Binding Items}"
                                          ItemTemplate="{StaticResource ProcessStatCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Style="{StaticResource SectionCardStyle}"
                Background="{StaticResource CardAltBrush}"
                BorderBrush="{StaticResource BorderBrushStrong}"
                Visibility="{Binding IsProcessDetailsOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="44"
                                Height="44"
                                CornerRadius="10"
                                Margin="0,0,14,0"
                                Background="{StaticResource CardAltBrush}"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                VerticalAlignment="Top">
                            <Image Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Image.Source>
                                    <Binding Path="DataContext.SelectedProcessStat.Pid" ElementName="ProcessPacketsLayout" Converter="{StaticResource ProcessIconConverter}"/>
                                </Image.Source>
                            </Image>
                        </Border>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Investigation details"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding DataContext.SelectedProcessStat.DisplayName, ElementName=ProcessPacketsLayout}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"/>
                            <WrapPanel Margin="0,6,0,0">
                                <TextBlock Margin="0,0,12,4"
                                           Text="{Binding DataContext.SelectedProcessStat.RiskLabel, ElementName=ProcessPacketsLayout}"
                                           Foreground="{Binding DataContext.SelectedProcessStat.RiskBrush, ElementName=ProcessPacketsLayout}"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>
                                <TextBlock Margin="0,0,12,4"
                                           Text="{Binding DataContext.SelectedProcessStat.LivenessLabel, ElementName=ProcessPacketsLayout}"
                                           Foreground="{Binding DataContext.SelectedProcessStat.LivenessBrush, ElementName=ProcessPacketsLayout}"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>
                                <Border Margin="0,0,12,4"
                                        Padding="8,2"
                                        Background="{StaticResource AccentBrushSoft}"
                                        BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Visibility="{Binding DataContext.SelectedProcessStat.HasFirewallBlockBadge, ElementName=ProcessPacketsLayout, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding DataContext.SelectedProcessStat.FirewallBlockBadgeLabel, ElementName=ProcessPacketsLayout}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}"/>
                                </Border>
                                <TextBlock Margin="0,0,12,4"
                                           Text="{Binding DataContext.SelectedProcessStat.BaselineStateLabel, ElementName=ProcessPacketsLayout}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"
                                           Visibility="{Binding DataContext.SelectedProcessStat.HasBaselineState, ElementName=ProcessPacketsLayout, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <TextBlock Margin="0,0,12,4"
                                           Text="{Binding DataContext.SelectedProcessStat.PacketCount, ElementName=ProcessPacketsLayout, StringFormat=Packets: {0:N0}}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"/>
                                <TextBlock Margin="0,0,12,4"
                                           Text="{Binding DataContext.SelectedProcessStat.TotalBytesHuman, ElementName=ProcessPacketsLayout, StringFormat=Traffic: {0}}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"/>
                                <TextBlock Margin="0,0,12,4"
                                           Text="{Binding DataContext.SelectedProcessStat.DistinctRemoteEndpoints, ElementName=ProcessPacketsLayout, StringFormat=Remotes: {0}}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"/>
                                <TextBlock Margin="0,0,12,4"
                                           Text="{Binding DataContext.SelectedProcessStat.LastSeenLabel, ElementName=ProcessPacketsLayout}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"/>
                            </WrapPanel>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Content="Back to process list"
                                Command="{Binding BackToProcessGridCommand}"
                                Style="{StaticResource ChipButtonStyle}"
                                Margin="12,0,0,0"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,14,0,0"
                          Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Button Grid.Row="0"
                                Grid.Column="0"
                                Content="Open folder"
                                Command="{Binding LocateProcessCommand}"
                                CommandParameter="{Binding DataContext.SelectedProcessStat, ElementName=ProcessPacketsLayout}"
                                Style="{StaticResource ProcessActionButtonStyle}"/>

                        <Grid Grid.Row="0"
                              Grid.Column="1"
                              x:Name="BlockActionsAnchor"
                              Margin="0,0,6,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Content="Block network"
                                    Command="{Binding BlockProcessFirewallCommand}"
                                    CommandParameter="{Binding DataContext.SelectedProcessStat, ElementName=ProcessPacketsLayout}"
                                    Style="{StaticResource ProcessActionButtonStyle}"
                                    Margin="0"/>

                            <ToggleButton Grid.Column="1"
                                          Content="▾"
                                          IsChecked="{Binding IsBlockPresetMenuOpen, Mode=TwoWay}"
                                          Style="{StaticResource ProcessActionArrowToggleStyle}"
                                          Margin="0"/>

                            <Popup PlacementTarget="{Binding ElementName=BlockActionsAnchor}"
                                   Placement="Bottom"
                                   HorizontalOffset="0"
                                   VerticalOffset="6"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   StaysOpen="False"
                                   IsOpen="{Binding DataContext.IsBlockPresetMenuOpen, ElementName=ProcessPacketsLayout, Mode=TwoWay}">
                                <Border Width="220"
                                        Padding="8"
                                        Background="{StaticResource CardBrush}"
                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        SnapsToDevicePixels="True">
                                    <StackPanel>
                                        <Button Content="Block permanently"
                                                Command="{Binding DataContext.BlockProcessFirewallCommand, ElementName=ProcessPacketsLayout}"
                                                CommandParameter="{Binding DataContext.SelectedProcessStat, ElementName=ProcessPacketsLayout}"
                                                Style="{StaticResource ProcessPopupActionButtonStyle}"/>
                                        <Button Content="Block for 15 min"
                                                Command="{Binding DataContext.BlockProcessFirewallFor15MinutesCommand, ElementName=ProcessPacketsLayout}"
                                                CommandParameter="{Binding DataContext.SelectedProcessStat, ElementName=ProcessPacketsLayout}"
                                                Style="{StaticResource ProcessPopupActionButtonStyle}"/>
                                        <Button Content="Block for 1 hour"
                                                Command="{Binding DataContext.BlockProcessFirewallFor1HourCommand, ElementName=ProcessPacketsLayout}"
                                                CommandParameter="{Binding DataContext.SelectedProcessStat, ElementName=ProcessPacketsLayout}"
                                                Style="{StaticResource ProcessPopupActionButtonStyle}"/>
                                        <Button Content="Block until app exit"
                                                Command="{Binding DataContext.BlockProcessFirewallUntilAppExitCommand, ElementName=ProcessPacketsLayout}"
                                                CommandParameter="{Binding DataContext.SelectedProcessStat, ElementName=ProcessPacketsLayout}"
                                                Style="{StaticResource ProcessPopupActionButtonStyle}"
                                                Margin="0"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <Button Grid.Row="0"
                                Grid.Column="2"
                                Content="Restore network"
                                Command="{Binding UnblockProcessFirewallCommand}"
                                CommandParameter="{Binding DataContext.SelectedProcessStat, ElementName=ProcessPacketsLayout}"
                                Style="{StaticResource ProcessActionButtonStyle}"
                                Margin="0,0,0,6"/>

                        <Button Grid.Row="1"
                                Grid.Column="0"
                                Content="End process"
                                Command="{Binding KillProcessCommand}"
                                CommandParameter="{Binding DataContext.SelectedProcessStat, ElementName=ProcessPacketsLayout}"
                                Style="{StaticResource ProcessActionButtonStyle}"
                                Margin="0,0,6,0"/>
                        <Button Grid.Row="1"
                                Grid.Column="1"
                                Content="Show packets"
                                Command="{Binding ShowPacketsForPidCommand}"
                                CommandParameter="{Binding DataContext.SelectedProcessStat, ElementName=ProcessPacketsLayout}"
                                Style="{StaticResource ProcessActionButtonStyle}"
                                Margin="0,0,6,0"/>
                        <Button Grid.Row="1"
                                Grid.Column="2"
                                Content="Export report"
                                Command="{Binding ExportIncidentReportCommand}"
                                CommandParameter="{Binding DataContext.SelectedProcessStat, ElementName=ProcessPacketsLayout}"
                                Style="{StaticResource ProcessActionButtonStyle}"
                                Margin="0"/>
                    </Grid>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              Margin="0,14,0,0">
                    <Grid>
                        <StackPanel Visibility="{Binding DataContext.SelectedProcessStat, ElementName=ProcessPacketsLayout, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Foreground="{StaticResource TextMutedBrush}" Text="No process selected."/>
                            <TextBlock Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" Text="Return to the process list and open a card to inspect its investigation details."/>
                        </StackPanel>

                        <ContentPresenter Content="{Binding DataContext.SelectedProcessStat, ElementName=ProcessPacketsLayout}"
                                          ContentTemplate="{StaticResource ProcessTimelineDetailsTemplate}"
                                          Visibility="{Binding DataContext.SelectedProcessStat, ElementName=ProcessPacketsLayout, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
