<Window x:Class="Presentation.Views.TrafficControlRulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:helpers="clr-namespace:Presentation.Helpers"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Traffic Control Rules"
        Width="1080"
        Height="760"
        MinWidth="960"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Border Padding="18" Background="{StaticResource WindowBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Bandwidth Limits, Priorities, Quotas, Scheduler"
                           Style="{StaticResource ViewTitleTextStyle}"/>
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource SectionCaptionTextStyle}"
                           Text="Rules can throttle traffic, mark priority with Windows QoS, and auto-block traffic after a daily quota is reached. QoS and firewall actions may request admin approval when they first become active."/>
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="12"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="Rules"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11"
                                       Text="Top rules are usually the ones you will revisit most often. Each rule can target a process, a host, or both."/>
                        </StackPanel>

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding Rules}"
                                  SelectedItem="{Binding SelectedRule, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  Style="{StaticResource AppTableDataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="On"
                                                        Binding="{Binding Enabled}"
                                                        Width="48"/>
                                <DataGridTextColumn Header="Name"
                                                    Binding="{Binding Name}"
                                                    Width="160"/>
                                <DataGridTextColumn Header="Target"
                                                    Binding="{Binding TargetSummary}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Control"
                                                    Binding="{Binding ControlSummary}"
                                                    Width="190"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="4"
                                    Orientation="Horizontal">
                            <Button Content="Add rule"
                                    MinWidth="96"
                                    Margin="0,0,8,0"
                                    Command="{Binding AddRuleCommand}"/>
                            <Button Content="Duplicate"
                                    MinWidth="96"
                                    Margin="0,0,8,0"
                                    Command="{Binding DuplicateRuleCommand}"/>
                            <Button Content="Delete"
                                    MinWidth="96"
                                    Command="{Binding DeleteRuleCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Padding="12"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Grid DataContext="{Binding SelectedRule}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Padding="14,12"
                                        Background="{StaticResource CardAltBrush}"
                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="180"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="Rule Basics"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>

                                        <CheckBox Grid.Column="1"
                                                  Content="Enabled"
                                                  IsChecked="{Binding Enabled, Mode=TwoWay}"/>

                                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                                            <TextBlock Text="Rule name"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="11"/>
                                            <TextBox Margin="0,6,0,0"
                                                     MinHeight="30"
                                                     Padding="8,4"
                                                     Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="4" Grid.ColumnSpan="2">
                                            <TextBlock Text="Target kind"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="11"/>
                                            <ComboBox Margin="0,6,0,0"
                                                      MinHeight="30"
                                                      Padding="8,3"
                                                      ItemsSource="{Binding DataContext.TargetOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding TargetKind, Mode=TwoWay}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="2"
                                        Padding="14,12"
                                        Background="{StaticResource CardAltBrush}"
                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock Text="Match Conditions"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>

                                        <StackPanel Margin="0,12,0,0"
                                                    Visibility="{Binding ShowsProcessFields, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="Process filter"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="11"/>
                                            <TextBlock Margin="0,4,0,0"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="11"
                                                       Text="Enter one or more process names, for example chrome, chrome.exe, powershell."/>
                                            <TextBox Margin="0,6,0,0"
                                                     MinHeight="30"
                                                     Padding="8,4"
                                                     Text="{Binding ProcessFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Margin="0,12,0,0"
                                                    Visibility="{Binding ShowsHostFields, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="Remote IP / CIDR"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="11"/>
                                            <TextBlock Margin="0,4,0,0"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="11"
                                                       Text="Examples: 142.250.0.0/16, 8.8.8.8, 2607:f8b0::/32"/>
                                            <TextBox Margin="0,6,0,0"
                                                     MinHeight="30"
                                                     Padding="8,4"
                                                     Text="{Binding RemoteAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="4"
                                        Padding="14,12"
                                        Background="{StaticResource CardAltBrush}"
                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="12"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="12"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.ColumnSpan="3"
                                                   Text="Controls"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>

                                        <StackPanel Grid.Row="2" Grid.Column="0">
                                            <TextBlock Text="Bandwidth limit (Mbps)"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="11"/>
                                            <TextBlock Margin="0,4,0,0"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="11"
                                                       Text="Set 0 to leave traffic unthrottled."/>
                                            <TextBox Margin="0,6,0,0"
                                                     MinHeight="30"
                                                     Padding="8,4"
                                                     Text="{Binding ThrottleMbps, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="2">
                                            <TextBlock Text="Priority"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="11"/>
                                            <TextBlock Margin="0,4,0,0"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="11"
                                                       Text="Priority uses Windows QoS DSCP marking."/>
                                            <ComboBox Margin="0,6,0,0"
                                                      MinHeight="30"
                                                      Padding="8,3"
                                                      ItemsSource="{Binding DataContext.PriorityOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding Priority, Mode=TwoWay}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="4" Grid.Column="0">
                                            <TextBlock Text="Daily quota (MB)"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="11"/>
                                            <TextBlock Margin="0,4,0,0"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="11"
                                                       Text="Set 0 to disable quota-based enforcement for this rule."/>
                                            <TextBox Margin="0,6,0,0"
                                                     MinHeight="30"
                                                     Padding="8,4"
                                                     Text="{Binding DailyQuotaMb, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="4" Grid.Column="2">
                                            <CheckBox Content="Notify when this rule triggers"
                                                      IsChecked="{Binding NotifyOnTrigger, Mode=TwoWay}"/>
                                            <CheckBox Margin="0,10,0,0"
                                                      Content="Auto-block when daily quota is reached"
                                                      IsChecked="{Binding AutoBlockOnQuota, Mode=TwoWay}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="6"
                                        Padding="14,12"
                                        Background="{StaticResource CardAltBrush}"
                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <StackPanel>
                                        <CheckBox Content="Use a schedule"
                                                  IsChecked="{Binding ScheduleEnabled, Mode=TwoWay}"/>
                                        <TextBlock Margin="0,6,0,0"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11"
                                                   Text="Overnight windows are supported. Example: 22:00 to 06:00."/>

                                        <WrapPanel Margin="0,12,0,0"
                                                   IsEnabled="{Binding ScheduleEnabled}">
                                            <CheckBox Content="Mon" IsChecked="{Binding Monday, Mode=TwoWay}" Margin="0,0,12,0"/>
                                            <CheckBox Content="Tue" IsChecked="{Binding Tuesday, Mode=TwoWay}" Margin="0,0,12,0"/>
                                            <CheckBox Content="Wed" IsChecked="{Binding Wednesday, Mode=TwoWay}" Margin="0,0,12,0"/>
                                            <CheckBox Content="Thu" IsChecked="{Binding Thursday, Mode=TwoWay}" Margin="0,0,12,0"/>
                                            <CheckBox Content="Fri" IsChecked="{Binding Friday, Mode=TwoWay}" Margin="0,0,12,0"/>
                                            <CheckBox Content="Sat" IsChecked="{Binding Saturday, Mode=TwoWay}" Margin="0,0,12,0"/>
                                            <CheckBox Content="Sun" IsChecked="{Binding Sunday, Mode=TwoWay}" Margin="0,0,12,0"/>
                                        </WrapPanel>

                                        <Grid Margin="0,12,0,0"
                                              IsEnabled="{Binding ScheduleEnabled}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Start (HH:mm)"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="11"/>
                                                <TextBox Margin="0,6,0,0"
                                                         MinHeight="30"
                                                         Padding="8,4"
                                                         Text="{Binding ScheduleStartText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="End (HH:mm)"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="11"/>
                                                <TextBox Margin="0,6,0,0"
                                                         MinHeight="30"
                                                         Padding="8,4"
                                                         Text="{Binding ScheduleEndText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding ValidationMessage}"
                           Foreground="#FFD16868"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,16,0"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            MinWidth="96"
                            Margin="0,0,8,0"
                            Command="{Binding CancelCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Button Content="Save"
                            MinWidth="96"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SaveCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
