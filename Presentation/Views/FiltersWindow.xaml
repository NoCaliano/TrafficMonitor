<Window x:Class="Presentation.Views.FiltersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pm="clr-namespace:Application.Filtering;assembly=Application"
        Title="Filters"
        Width="980"
        MinWidth="820"
        MinHeight="650"
        MaxHeight="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="FilterSectionStyle" TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="FilterLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="FilterHintStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedTextBlockStyle}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="FilterComboStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="MinWidth" Value="108"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="FilterTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>

        <Style x:Key="ShortFilterTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="MinWidth" Value="74"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>

        <Style x:Key="CompactPortComboStyle" TargetType="ComboBox" BasedOn="{StaticResource FilterComboStyle}">
            <Setter Property="MinWidth" Value="96"/>
        </Style>

        <Style x:Key="FooterButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="MinWidth" Value="98"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource WindowBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="22,20,22,16"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Packet Filters" Style="{StaticResource ViewTitleTextStyle}"/>
                        <TextBlock Margin="0,5,0,0"
                                   Style="{StaticResource SectionCaptionTextStyle}"
                                   Text="Filter the packets table by addresses, ports, timing, protocol, and process context."/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Padding="12,6"
                            CornerRadius="12"
                            Background="{StaticResource AccentBrushSoft}"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <TextBlock Text="UI filter"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          Padding="22,18,22,4"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <GroupBox Header="IP addresses" Style="{StaticResource FilterSectionStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Source" Style="{StaticResource FilterLabelStyle}"/>
                                <ComboBox Grid.Column="1"
                                          Style="{StaticResource FilterComboStyle}"
                                          SelectedValue="{Binding Filter.SrcIpOp}"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Any" Tag="{x:Static pm:TextMatchOp.Any}"/>
                                    <ComboBoxItem Content="Equals" Tag="{x:Static pm:TextMatchOp.Equals}"/>
                                    <ComboBoxItem Content="Not Equals" Tag="{x:Static pm:TextMatchOp.NotEquals}"/>
                                    <ComboBoxItem Content="Contains" Tag="{x:Static pm:TextMatchOp.Contains}"/>
                                    <ComboBoxItem Content="Not Contains" Tag="{x:Static pm:TextMatchOp.NotContains}"/>
                                </ComboBox>
                                <TextBox Grid.Column="2"
                                         Style="{StaticResource FilterTextBoxStyle}"
                                         Text="{Binding Filter.SrcIpValue, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <Grid Grid.Row="0" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Destination" Style="{StaticResource FilterLabelStyle}"/>
                                <ComboBox Grid.Column="1"
                                          Style="{StaticResource FilterComboStyle}"
                                          SelectedValue="{Binding Filter.DstIpOp}"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Any" Tag="{x:Static pm:TextMatchOp.Any}"/>
                                    <ComboBoxItem Content="Equals" Tag="{x:Static pm:TextMatchOp.Equals}"/>
                                    <ComboBoxItem Content="Not Equals" Tag="{x:Static pm:TextMatchOp.NotEquals}"/>
                                    <ComboBoxItem Content="Contains" Tag="{x:Static pm:TextMatchOp.Contains}"/>
                                    <ComboBoxItem Content="Not Contains" Tag="{x:Static pm:TextMatchOp.NotContains}"/>
                                </ComboBox>
                                <TextBox Grid.Column="2"
                                         Style="{StaticResource FilterTextBoxStyle}"
                                         Text="{Binding Filter.DstIpValue, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <Grid Grid.Row="2" Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Either" Style="{StaticResource FilterLabelStyle}"/>
                                <ComboBox Grid.Column="1"
                                          Style="{StaticResource FilterComboStyle}"
                                          SelectedValue="{Binding Filter.AnyIpOp}"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Any" Tag="{x:Static pm:TextMatchOp.Any}"/>
                                    <ComboBoxItem Content="Equals" Tag="{x:Static pm:TextMatchOp.Equals}"/>
                                    <ComboBoxItem Content="Not Equals" Tag="{x:Static pm:TextMatchOp.NotEquals}"/>
                                    <ComboBoxItem Content="Contains" Tag="{x:Static pm:TextMatchOp.Contains}"/>
                                    <ComboBoxItem Content="Not Contains" Tag="{x:Static pm:TextMatchOp.NotContains}"/>
                                </ComboBox>
                                <TextBox Grid.Column="2"
                                         Style="{StaticResource FilterTextBoxStyle}"
                                         Text="{Binding Filter.AnyIpValue, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <Border Grid.Row="2"
                                    Grid.Column="2"
                                    Padding="12,8"
                                    CornerRadius="10"
                                    Background="{StaticResource CardAltBrush}"
                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1">
                                <TextBlock Style="{StaticResource FilterHintStyle}"
                                           Text="Either IP checks both source and destination address fields."/>
                            </Border>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Ports" Style="{StaticResource FilterSectionStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Either" Style="{StaticResource FilterLabelStyle}"/>
                                <ComboBox Grid.Column="1"
                                          Style="{StaticResource CompactPortComboStyle}"
                                          SelectedValue="{Binding Filter.AnyPortOp}"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Any" Tag="{x:Static pm:NumberMatchOp.Any}"/>
                                    <ComboBoxItem Content="Equals" Tag="{x:Static pm:NumberMatchOp.Equals}"/>
                                    <ComboBoxItem Content="Not Equals" Tag="{x:Static pm:NumberMatchOp.NotEquals}"/>
                                </ComboBox>
                                <TextBox Grid.Column="2"
                                         Style="{StaticResource ShortFilterTextBoxStyle}"
                                         Text="{Binding Filter.AnyPortValue, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <Grid Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Source" Style="{StaticResource FilterLabelStyle}"/>
                                <ComboBox Grid.Column="1"
                                          Style="{StaticResource CompactPortComboStyle}"
                                          SelectedValue="{Binding Filter.SrcPortOp}"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Any" Tag="{x:Static pm:NumberMatchOp.Any}"/>
                                    <ComboBoxItem Content="Equals" Tag="{x:Static pm:NumberMatchOp.Equals}"/>
                                    <ComboBoxItem Content="Not Equals" Tag="{x:Static pm:NumberMatchOp.NotEquals}"/>
                                </ComboBox>
                                <TextBox Grid.Column="2"
                                         Style="{StaticResource ShortFilterTextBoxStyle}"
                                         Text="{Binding Filter.SrcPortValue, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <Grid Grid.Column="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Destination" Style="{StaticResource FilterLabelStyle}"/>
                                <ComboBox Grid.Column="1"
                                          Style="{StaticResource CompactPortComboStyle}"
                                          SelectedValue="{Binding Filter.DstPortOp}"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Any" Tag="{x:Static pm:NumberMatchOp.Any}"/>
                                    <ComboBoxItem Content="Equals" Tag="{x:Static pm:NumberMatchOp.Equals}"/>
                                    <ComboBoxItem Content="Not Equals" Tag="{x:Static pm:NumberMatchOp.NotEquals}"/>
                                </ComboBox>
                                <TextBox Grid.Column="2"
                                         Style="{StaticResource ShortFilterTextBoxStyle}"
                                         Text="{Binding Filter.DstPortValue, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Time range" Style="{StaticResource FilterSectionStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="From" Style="{StaticResource FilterLabelStyle}"/>
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource FilterTextBoxStyle}"
                                         Text="{Binding TimeFromText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Formats: HH:mm:ss or yyyy-MM-dd HH:mm:ss"/>
                            </Grid>

                            <Grid Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="To" Style="{StaticResource FilterLabelStyle}"/>
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource FilterTextBoxStyle}"
                                         Text="{Binding TimeToText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Formats: HH:mm:ss or yyyy-MM-dd HH:mm:ss"/>
                            </Grid>

                            <Border Grid.Row="2"
                                    Grid.ColumnSpan="3"
                                    Padding="12,8"
                                    CornerRadius="10"
                                    Background="{StaticResource CardAltBrush}"
                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1">
                                <TextBlock Style="{StaticResource FilterHintStyle}"
                                           Text="Use HH:mm:ss for today's packets, or yyyy-MM-dd HH:mm:ss for an exact local date and time."/>
                            </Border>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Protocol and packet text" Style="{StaticResource FilterSectionStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Protocol" Style="{StaticResource FilterLabelStyle}"/>
                                <ComboBox Grid.Column="1"
                                          Style="{StaticResource FilterComboStyle}"
                                          SelectedValue="{Binding Filter.ProtocolOp}"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Any" Tag="{x:Static pm:TextMatchOp.Any}"/>
                                    <ComboBoxItem Content="Equals" Tag="{x:Static pm:TextMatchOp.Equals}"/>
                                    <ComboBoxItem Content="Not Equals" Tag="{x:Static pm:TextMatchOp.NotEquals}"/>
                                    <ComboBoxItem Content="Contains" Tag="{x:Static pm:TextMatchOp.Contains}"/>
                                    <ComboBoxItem Content="Not Contains" Tag="{x:Static pm:TextMatchOp.NotContains}"/>
                                </ComboBox>
                                <ComboBox Grid.Column="2"
                                          IsEditable="True"
                                          ItemsSource="{Binding ProtocolOptions}"
                                          Text="{Binding Filter.ProtocolValue, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <Grid Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Info" Style="{StaticResource FilterLabelStyle}"/>
                                <ComboBox Grid.Column="1"
                                          Style="{StaticResource FilterComboStyle}"
                                          SelectedValue="{Binding Filter.InfoOp}"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Any" Tag="{x:Static pm:TextMatchOp.Any}"/>
                                    <ComboBoxItem Content="Contains" Tag="{x:Static pm:TextMatchOp.Contains}"/>
                                    <ComboBoxItem Content="Not Contains" Tag="{x:Static pm:TextMatchOp.NotContains}"/>
                                    <ComboBoxItem Content="Equals" Tag="{x:Static pm:TextMatchOp.Equals}"/>
                                    <ComboBoxItem Content="Not Equals" Tag="{x:Static pm:TextMatchOp.NotEquals}"/>
                                </ComboBox>
                                <TextBox Grid.Column="2"
                                         Style="{StaticResource FilterTextBoxStyle}"
                                         Text="{Binding Filter.InfoValue, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Process and packet length" Style="{StaticResource FilterSectionStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="PID" Style="{StaticResource FilterLabelStyle}"/>
                                <ComboBox Grid.Column="1"
                                          Style="{StaticResource FilterComboStyle}"
                                          SelectedValue="{Binding Filter.PidOp}"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Any" Tag="{x:Static pm:NumberMatchOp.Any}"/>
                                    <ComboBoxItem Content="Equals" Tag="{x:Static pm:NumberMatchOp.Equals}"/>
                                    <ComboBoxItem Content="Not Equals" Tag="{x:Static pm:NumberMatchOp.NotEquals}"/>
                                </ComboBox>
                                <TextBox Grid.Column="2"
                                         Style="{StaticResource ShortFilterTextBoxStyle}"
                                         Text="{Binding Filter.PidValue, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <Grid Grid.Row="0" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Process" Style="{StaticResource FilterLabelStyle}"/>
                                <ComboBox Grid.Column="1"
                                          Style="{StaticResource FilterComboStyle}"
                                          SelectedValue="{Binding Filter.ProcessNameOp}"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Any" Tag="{x:Static pm:TextMatchOp.Any}"/>
                                    <ComboBoxItem Content="Equals" Tag="{x:Static pm:TextMatchOp.Equals}"/>
                                    <ComboBoxItem Content="Not Equals" Tag="{x:Static pm:TextMatchOp.NotEquals}"/>
                                    <ComboBoxItem Content="Contains" Tag="{x:Static pm:TextMatchOp.Contains}"/>
                                    <ComboBoxItem Content="Not Contains" Tag="{x:Static pm:TextMatchOp.NotContains}"/>
                                </ComboBox>
                                <TextBox Grid.Column="2"
                                         Style="{StaticResource FilterTextBoxStyle}"
                                         Text="{Binding Filter.ProcessNameValue, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <Grid Grid.Row="2" Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Min len" Style="{StaticResource FilterLabelStyle}"/>
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource ShortFilterTextBoxStyle}"
                                         Text="{Binding Filter.MinLength, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Column="3" Text="Max len" Style="{StaticResource FilterLabelStyle}"/>
                                <TextBox Grid.Column="4"
                                         Style="{StaticResource ShortFilterTextBoxStyle}"
                                         Text="{Binding Filter.MaxLength, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <Border Grid.Row="2"
                                    Grid.Column="2"
                                    Padding="12,8"
                                    CornerRadius="10"
                                    Background="{StaticResource CardAltBrush}"
                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1">
                                <TextBlock Style="{StaticResource FilterHintStyle}"
                                           Text="Leave packet length fields empty when no size limit is needed."/>
                            </Border>
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Padding="22,14,22,18"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock Style="{StaticResource FilterHintStyle}"
                               VerticalAlignment="Center"
                               Text="Changes are applied when you press Apply."/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Clear"
                                Style="{StaticResource FooterButtonStyle}"
                                Command="{Binding ClearCommand}"/>

                        <Button Content="Cancel"
                                Style="{StaticResource FooterButtonStyle}"
                                Command="{Binding CancelCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>

                        <Button Content="Apply"
                                MinWidth="104"
                                Margin="8,0,0,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ApplyCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
