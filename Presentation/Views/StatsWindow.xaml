<Window x:Class="Presentation.Views.StatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentation.Views"
        mc:Ignorable="d"
        Title="Capture Statistics" Height="620" Width="980" MinHeight="520" MinWidth="860">
    <Grid Margin="14" Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Summary -->
        <GroupBox Header="Summary" Grid.Row="0">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock FontWeight="Bold" Text="Totals"/>
                    <TextBlock Text="{Binding SummaryTotalPackets, StringFormat=Packets: {0}}" />
                    <TextBlock Text="{Binding SummaryFlowsShown, StringFormat=Flows (top snapshot): {0}}" />
                    <TextBlock Text="{Binding SummaryTotalBytesHuman, StringFormat=Bytes: {0}}" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock FontWeight="Bold" Text="Time"/>
                    <TextBlock Text="{Binding SummaryFirstSeen, StringFormat=First: {0:HH:mm:ss}}" />
                    <TextBlock Text="{Binding SummaryLastSeen, StringFormat=Last: {0:HH:mm:ss}}" />
                    <TextBlock Text="{Binding SummaryDuration, StringFormat=Duration: {0}}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock FontWeight="Bold" Text="Rate"/>
                    <TextBlock Text="{Binding SummaryPacketsPerSec}" />
                    <TextBlock Text="{Binding SummaryBytesPerSec}" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Controls -->
        <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Content="Hide multicast/broadcast"
                          IsChecked="{Binding HideMulticastBroadcast}"/>

                <TextBlock Margin="14,0,6,0" Text="Top N:" VerticalAlignment="Center"/>
                <TextBox Width="72" Text="{Binding StatsTopN}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Top Hosts -->
        <GroupBox Header="Top Hosts" Grid.Row="4">
            <DataGrid ItemsSource="{Binding TopHosts}"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="*"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90"/>
                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="90"/>
                    <DataGridTextColumn Header="Flows" Binding="{Binding Flows}" Width="80"/>
                    <DataGridTextColumn Header="Packets" Binding="{Binding Packets}" Width="90"/>
                    <DataGridTextColumn Header="Bytes" Binding="{Binding Bytes}" Width="110"/>
                    <DataGridTextColumn Header="Sent" Binding="{Binding SentBytes}" Width="110"/>
                    <DataGridTextColumn Header="Recv" Binding="{Binding RecvBytes}" Width="110"/>
                    <DataGridTextColumn Header="Last" Binding="{Binding LastSeen, StringFormat=HH:mm:ss}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <GridSplitter Grid.Row="5" Height="10" HorizontalAlignment="Stretch"/>

        <!-- Top Ports -->
        <GroupBox Header="Top Ports" Grid.Row="6">
            <DataGrid ItemsSource="{Binding TopPorts}"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Proto" Binding="{Binding Protocol}" Width="70"/>
                    <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="70"/>
                    <DataGridTextColumn Header="Service" Binding="{Binding Service}" Width="110"/>
                    <DataGridTextColumn Header="Flows" Binding="{Binding Flows}" Width="80"/>
                    <DataGridTextColumn Header="Packets" Binding="{Binding Packets}" Width="90"/>
                    <DataGridTextColumn Header="Bytes" Binding="{Binding Bytes}" Width="110"/>
                    <DataGridTextColumn Header="Sent" Binding="{Binding SentBytes}" Width="110"/>
                    <DataGridTextColumn Header="Recv" Binding="{Binding RecvBytes}" Width="110"/>
                    <DataGridTextColumn Header="Last" Binding="{Binding LastSeen, StringFormat=HH:mm:ss}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</Window>
