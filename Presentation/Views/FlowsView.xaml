<UserControl x:Class="Presentation.Views.FlowsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:domain="clr-namespace:Domain.Models;assembly=Domain"
             xmlns:helpers="clr-namespace:Presentation.Helpers">

    <UserControl.Resources>
        <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <DataTemplate x:Key="FlowDetailsTemplate" DataType="{x:Type domain:FlowInfo}">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                           Text="{Binding Protocol, StringFormat={}{0} flow}" />

                <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextMutedBrush}" Text="Local" FontSize="11" />
                <TextBlock Text="{Binding LocalEndpoint}" TextWrapping="Wrap"/>

                <TextBlock Margin="0,10,0,0" Foreground="{StaticResource TextMutedBrush}" Text="Remote" FontSize="11" />
                <TextBlock Text="{Binding RemoteEndpoint}" TextWrapping="Wrap"/>

                <Separator Margin="0,12,0,12"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="Direction"/>
                        <TextBlock FontWeight="SemiBold" Text="{Binding Dir}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1">
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="Duration"/>
                        <TextBlock FontWeight="SemiBold" Text="{Binding Duration}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,0,0">
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="Packets"/>
                        <TextBlock FontWeight="SemiBold" Text="{Binding Packets, StringFormat={}{0:N0}}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="Bytes"/>
                        <TextBlock FontWeight="SemiBold" Text="{Binding Bytes, StringFormat={}{0:N0}}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,10,0,0">
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="First"/>
                        <TextBlock Text="{Binding FirstSeen, StringFormat={}{0:HH:mm:ss}}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,10,0,0">
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="Last"/>
                        <TextBlock Text="{Binding LastSeen, StringFormat={}{0:HH:mm:ss}}"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,12,0,12"/>

                <TextBlock FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="Traffic split"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="A → B"/>
                        <TextBlock Text="{Binding PacketsAToB, StringFormat={}{0:N0} pkts}"/>
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="{Binding BytesAToB, StringFormat={}{0:N0} bytes}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="B → A"/>
                        <TextBlock Text="{Binding PacketsBToA, StringFormat={}{0:N0} pkts}"/>
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="{Binding BytesBToA, StringFormat={}{0:N0} bytes}"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,12,0,12"/>

                <TextBlock FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Text="Local (sent / recv)"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="Sent"/>
                        <TextBlock Text="{Binding SentPackets, StringFormat={}{0:N0} pkts}"/>
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="{Binding SentBytes, StringFormat={}{0:N0} bytes}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="Recv"/>
                        <TextBlock Text="{Binding RecvPackets, StringFormat={}{0:N0} pkts}"/>
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="{Binding RecvBytes, StringFormat={}{0:N0} bytes}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Margin="0"
                Style="{StaticResource SectionCardStyle}">
            <DataGrid ItemsSource="{Binding Flows}"
                      SelectedItem="{Binding SelectedFlow}"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">

                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Follow Flow" Command="{Binding FollowFlowCommand}" />
                        <MenuItem Header="Follow Flow (Both directions)" Command="{Binding FollowFlowBothDirectionsCommand}" />
                        <Separator/>
                        <MenuItem Header="Clear Flow Filter" Command="{Binding ClearFlowFilterCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Dir" Binding="{Binding Dir}" Width="60"/>
                    <DataGridTextColumn Header="Proto" Binding="{Binding Key.Protocol}" Width="60"/>
                    <DataGridTextColumn Header="Src" Binding="{Binding SrcIp}" Width="160"/>
                    <DataGridTextColumn Header="SPort" Binding="{Binding SrcPort}" Width="70"/>
                    <DataGridTextColumn Header="Dst" Binding="{Binding DstIp}" Width="160"/>
                    <DataGridTextColumn Header="DPort" Binding="{Binding DstPort}" Width="70"/>
                    <DataGridTextColumn Header="Packets" Binding="{Binding Packets}" Width="90"/>
                    <DataGridTextColumn Header="Bytes" Binding="{Binding Bytes}" Width="110"/>
                    <DataGridTextColumn Header="First" Binding="{Binding FirstSeen, StringFormat=HH:mm:ss}" Width="90"/>
                    <DataGridTextColumn Header="Last" Binding="{Binding LastSeen, StringFormat=HH:mm:ss}" Width="90"/>
                    <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <Border Grid.Column="2" Margin="12,0,0,0" Style="{StaticResource SectionCardStyle}">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Flow details" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <Grid>
                        <StackPanel x:Name="NoFlowPlaceholder"
                                    Visibility="{Binding SelectedFlow, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Foreground="{StaticResource TextMutedBrush}" Text="No flow selected." />
                            <TextBlock Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" Text="Select a row in the table to see details." />
                        </StackPanel>

                        <ContentPresenter Content="{Binding SelectedFlow}"
                                          ContentTemplate="{StaticResource FlowDetailsTemplate}"
                                          Visibility="{Binding SelectedFlow, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}" />
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
