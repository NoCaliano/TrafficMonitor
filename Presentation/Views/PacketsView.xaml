<UserControl x:Class="Presentation.Views.PacketsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:Presentation.Helpers">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="260"/>
        </Grid.RowDefinitions>

        <!-- Packets table -->
        <DataGrid Grid.Row="0"
                  ItemsSource="{Binding PacketsView}"
                  SelectedItem="{Binding SelectedPacket}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">

            <DataGrid.Columns>
                <DataGridTextColumn Header="No" Binding="{Binding No}" Width="60"/>
                <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=HH:mm:ss.fff}" Width="110"/>
                <DataGridTextColumn Header="Src" Binding="{Binding SrcIp}" Width="140"/>
                <DataGridTextColumn Header="Dst" Binding="{Binding DstIp}" Width="140"/>
                <DataGridTextColumn Header="Proto" Binding="{Binding Protocol}" Width="60"/>
                <DataGridTextColumn Header="SPort" Binding="{Binding SrcPort}" Width="60"/>
                <DataGridTextColumn Header="DPort" Binding="{Binding DstPort}" Width="60"/>
                <DataGridTextColumn Header="Len" Binding="{Binding Length}" Width="70"/>
                <DataGridTextColumn Header="Flags" Binding="{Binding TcpFlags}" Width="110"/>

                <!-- майбутнє: PID/Process -->
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70"/>
                <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="130"/>

                <DataGridTextColumn Header="Info" Binding="{Binding Info}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"/>

        <!-- Details + Hex -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Packet Details" Margin="0">
                <TreeView ItemsSource="{Binding ProtocolRoot.Items}"
                          PreviewMouseMove="ProtocolTree_PreviewMouseMove"
                          MouseLeave="ProtocolTree_MouseLeave">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type TreeViewItem}" ItemsSource="{Binding Items}">
                            <TextBlock Text="{Binding Header}" />
                        </HierarchicalDataTemplate>

                        <Style TargetType="{x:Type TreeViewItem}">
                            <EventSetter Event="MouseEnter" Handler="ProtocolTreeItem_MouseEnter"/>
                            <EventSetter Event="Selected" Handler="ProtocolTreeItem_Selected"/>
                        </Style>
                    </TreeView.Resources>
                </TreeView>
            </GroupBox>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>

            <GroupBox Grid.Column="2" Header="Hex" Margin="0">
                <RichTextBox helpers:RichTextBoxAssist.BindableDocument="{Binding HexDocument}"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             FontSize="12"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Margin="0"/>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>