<!-- MainWindow.xaml -->
<Window x:Class="Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:views="clr-namespace:Presentation.Views"
        xmlns:helpers="clr-namespace:Presentation.Helpers"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrafficMonitor"
        Height="650"
        Width="1200">

    <DockPanel LastChildFill="True" Margin="0">

        <!-- ===== TOP MENU ===== -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#FFD0D0D0" BorderThickness="0,0,0,1">
            <Menu Background="White" BorderThickness="0" Padding="2,0" FontSize="12">
                <Menu.Resources>
                    <Style TargetType="{x:Type MenuItem}">
                        <Setter Property="Padding" Value="8,2"/>
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </Menu.Resources>

                <MenuItem Header="_File"/>
                <MenuItem Header="_Edit"/>
                <MenuItem Header="_View"/>
                <MenuItem Header="_Go"/>
                <MenuItem Header="_Capture"/>
                <MenuItem Header="_Analyze"/>
                <MenuItem Header="_Statistics"/>
            </Menu>
        </Border>

        <!-- ===== CAPTURE TOOLBAR ===== -->
        <Border DockPanel.Dock="Top" Background="#FFF7F7F7" BorderBrush="#FFD0D0D0" BorderThickness="0,0,0,1">
            <ToolBarTray Background="#FFF7F7F7" IsLocked="True">
                <ToolBar Background="#FFF7F7F7" BorderThickness="0" Padding="2" MinHeight="28">
                    <ToolBar.Resources>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Padding" Value="10,2"/>
                            <Setter Property="Margin" Value="2,0"/>
                            <Setter Property="MinHeight" Value="24"/>
                        </Style>
                        <Style TargetType="{x:Type TextBox}">
                            <Setter Property="Margin" Value="2,0"/>
                            <Setter Property="MinHeight" Value="24"/>
                        </Style>
                        <Style TargetType="{x:Type ComboBox}">
                            <Setter Property="Margin" Value="2,0"/>
                            <Setter Property="MinHeight" Value="24"/>
                        </Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Margin" Value="6,0,0,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </ToolBar.Resources>

                    <ComboBox Width="Auto"
                              Padding="0,0,26,0"
                              HorizontalContentAlignment="Left"
                              ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice}"
                              DisplayMemberPath="Name"/>

                    <TextBox Width="320"
                             Text="{Binding BpfFilter}"
                             ToolTip="BPF filter (наприклад: tcp port 443)"/>

                    <Separator/>

                    <Button Content="Start" Command="{Binding StartCommand}" />
                    <Button Content="Stop"  Command="{Binding StopCommand}" />
                    <Button Content="Filters..." Command="{Binding OpenFiltersCommand}" />
                    <Button Content="Clear Filter" Command="{Binding ClearFlowFilterCommand}" />

                    <Separator/>

                    <TextBlock Text="{Binding StatusText}"/>
                    <TextBlock Foreground="DarkOrange" Text="{Binding FiltersText}"/>
                </ToolBar>
            </ToolBarTray>
        </Border>

        <!-- ===== BOTTOM STATUS BAR ===== -->
        <StatusBar DockPanel.Dock="Bottom"
                   Background="#FFF7F7F7"
                   BorderBrush="#FFD0D0D0"
                   BorderThickness="1,0,0,0"
                   Padding="4,1">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontWeight="SemiBold" Text="Capture:"/>
                    <TextBlock Margin="8,0,0,0" Text="{Binding Stats.SummaryTotalPackets, StringFormat=Packets: {0:N0}}"/>
                    <TextBlock Margin="12,0,0,0" Text="{Binding Stats.SummaryPacketsPerSec, StringFormat=Rate: {0}}"/>
                    <TextBlock Margin="12,0,0,0" Text="{Binding Stats.SummaryTotalBytesHuman, StringFormat=Size: {0}}"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- ===== MAIN CONTENT (edge-to-edge) ===== -->
        <Grid Margin="0">
            <TabControl SelectedIndex="{Binding LeftTabIndex}" Margin="0" Padding="0">

                <!-- ===================== Packets ===================== -->
                <TabItem Header="Packets">
                    <Grid Margin="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="260"/>
                        </Grid.RowDefinitions>

                        <DataGrid Grid.Row="0"
                                  Margin="0"
                                  ItemsSource="{Binding PacketsView}"
                                  SelectedItem="{Binding SelectedPacket}"
                                  IsReadOnly="True"
                                  AutoGenerateColumns="False"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="No"
                                        Binding="{Binding No}"
                                        Width="55">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Time"    Binding="{Binding Timestamp, StringFormat=HH:mm:ss.fff}" Width="110"/>
                                <DataGridTextColumn Header="Src"     Binding="{Binding SrcIp}" Width="140"/>
                                <DataGridTextColumn Header="Dst"     Binding="{Binding DstIp}" Width="140"/>
                                <DataGridTextColumn Header="Proto"   Binding="{Binding Protocol}" Width="60"/>
                                <DataGridTextColumn Header="SPort"   Binding="{Binding SrcPort}" Width="60"/>
                                <DataGridTextColumn Header="DPort"   Binding="{Binding DstPort}" Width="60"/>
                                <DataGridTextColumn Header="Len"     Binding="{Binding Length}" Width="70"/>
                                <DataGridTextColumn Header="Flags"   Binding="{Binding TcpFlags}" Width="110"/>
                                <DataGridTextColumn Header="PID"     Binding="{Binding Pid}" Width="70"/>
                                <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="130"/>
                                <DataGridTextColumn Header="Info"    Binding="{Binding Info}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <GridSplitter Grid.Row="1"
                                      Height="6"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"/>

                        <!-- Нижня панель: Details + Hex -->
                        <Grid Grid.Row="2" Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <GroupBox Grid.Column="0" Header="Packet Details" Margin="0">
                                <TreeView ItemsSource="{Binding ProtocolRoot.Items}"
                                          PreviewMouseMove="ProtocolTree_PreviewMouseMove"
                                          MouseLeave="ProtocolTree_MouseLeave"
                                          Margin="0">
                                    <TreeView.Resources>
                                        <HierarchicalDataTemplate DataType="{x:Type TreeViewItem}" ItemsSource="{Binding Items}">
                                            <TextBlock Text="{Binding Header}" />
                                        </HierarchicalDataTemplate>

                                        <Style TargetType="{x:Type TreeViewItem}">
                                            <EventSetter Event="MouseEnter" Handler="ProtocolTreeItem_MouseEnter"/>
                                            <EventSetter Event="Selected" Handler="ProtocolTreeItem_Selected"/>
                                        </Style>
                                    </TreeView.Resources>
                                </TreeView>
                            </GroupBox>

                            <GridSplitter Grid.Column="1" Width="6"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"/>

                            <GroupBox Grid.Column="2" Header="Hex" Margin="0">
                                <RichTextBox Margin="0"
                                             helpers:RichTextBoxAssist.BindableDocument="{Binding HexDocument}"
                                             IsReadOnly="True"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"/>
                            </GroupBox>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ===================== Flows ===================== -->
                <TabItem Header="Flows">
                    <Grid Margin="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="200"/>
                        </Grid.RowDefinitions>

                        <DataGrid Grid.Row="0"
                                  Margin="0"
                                  ItemsSource="{Binding Flows}"
                                  SelectedItem="{Binding SelectedFlow}"
                                  IsReadOnly="True"
                                  AutoGenerateColumns="False"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">

                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Follow Flow" Command="{Binding FollowFlowCommand}" />
                                    <MenuItem Header="Follow Flow (Both directions)" Command="{Binding FollowFlowBothDirectionsCommand}" />
                                    <Separator/>
                                    <MenuItem Header="Clear Flow Filter" Command="{Binding ClearFlowFilterCommand}" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Dir"     Binding="{Binding Dir}" Width="60"/>
                                <DataGridTextColumn Header="Proto"   Binding="{Binding Key.Protocol}" Width="60"/>
                                <DataGridTextColumn Header="Src"     Binding="{Binding Key.SrcIp}" Width="160"/>
                                <DataGridTextColumn Header="SPort"   Binding="{Binding Key.SrcPort}" Width="60"/>
                                <DataGridTextColumn Header="Dst"     Binding="{Binding Key.DstIp}" Width="160"/>
                                <DataGridTextColumn Header="DPort"   Binding="{Binding Key.DstPort}" Width="60"/>
                                <DataGridTextColumn Header="Packets" Binding="{Binding Packets}" Width="80"/>
                                <DataGridTextColumn Header="Bytes"   Binding="{Binding Bytes}" Width="90"/>
                                <DataGridTextColumn Header="First"   Binding="{Binding FirstSeen, StringFormat=HH:mm:ss}" Width="80"/>
                                <DataGridTextColumn Header="Last"    Binding="{Binding LastSeen, StringFormat=HH:mm:ss}" Width="80"/>
                                <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <GridSplitter Grid.Row="1"
                                      Height="6"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"/>

                        <GroupBox Grid.Row="2" Header="Flow Details" Margin="0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0">
                                <StackPanel DataContext="{Binding SelectedFlow}" Margin="6">
                                    <TextBlock Text="{Binding Dir, StringFormat=Direction: {0}}" />
                                    <TextBlock Text="{Binding LocalEndpoint, StringFormat=Local: {0}}" />
                                    <TextBlock Text="{Binding RemoteEndpoint, StringFormat=Remote: {0}}" />
                                    <Separator Margin="0,10,0,10"/>
                                    <TextBlock FontWeight="Bold" Text="Totals" />
                                    <TextBlock Text="{Binding Packets, StringFormat=Packets: {0}}" />
                                    <TextBlock Text="{Binding Bytes, StringFormat=Bytes: {0}}" />
                                    <Separator Margin="0,10,0,10"/>
                                    <TextBlock FontWeight="Bold" Text="A ↔ B (normalized)" />
                                    <TextBlock Text="{Binding PacketsAToB, StringFormat=A→B Packets: {0}}" />
                                    <TextBlock Text="{Binding BytesAToB, StringFormat=A→B Bytes: {0}}" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding PacketsBToA, StringFormat=B→A Packets: {0}}" />
                                    <TextBlock Text="{Binding BytesBToA, StringFormat=B→A Bytes: {0}}" />
                                    <Separator Margin="0,10,0,10"/>
                                    <TextBlock FontWeight="Bold" Text="Local (Sent / Recv)" />
                                    <TextBlock Text="{Binding SentPackets, StringFormat=Sent Packets: {0}}" />
                                    <TextBlock Text="{Binding SentBytes, StringFormat=Sent Bytes: {0}}" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding RecvPackets, StringFormat=Recv Packets: {0}}" />
                                    <TextBlock Text="{Binding RecvBytes, StringFormat=Recv Bytes: {0}}" />
                                    <Separator Margin="0,10,0,10"/>
                                    <TextBlock FontWeight="Bold" Text="Timing" />
                                    <TextBlock Text="{Binding FirstSeen, StringFormat=First: {0:HH:mm:ss}}" />
                                    <TextBlock Text="{Binding LastSeen, StringFormat=Last: {0:HH:mm:ss}}" />
                                    <TextBlock Text="{Binding Duration, StringFormat=Duration: {0}}" />
                                </StackPanel>
                            </ScrollViewer>
                        </GroupBox>
                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>

    </DockPanel>
</Window>