<!-- MainWindow.xaml -->
<Window x:Class="Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:views="clr-namespace:Presentation.Views"
        xmlns:helpers="clr-namespace:Presentation.Helpers"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrafficMonitor"
        Height="650"
        Width="1200">

    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="O" Command="{Binding OpenCaptureCommand}" />
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveCaptureCommand}" />
    </Window.InputBindings>

    <DockPanel LastChildFill="True" Margin="0">

        <!-- ===== TOP MENU ===== -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#FFD0D0D0" BorderThickness="0,0,0,1">
            <Menu Background="White" BorderThickness="0" Padding="2,0" FontSize="12">
                <Menu.Resources>
                    <Style TargetType="{x:Type MenuItem}">
                        <Setter Property="Padding" Value="8,2"/>
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </Menu.Resources>

                <MenuItem Header="_File">
                    <MenuItem Header="_Open..." Command="{Binding OpenCaptureCommand}" InputGestureText="Ctrl+O"/>
                    <MenuItem Header="Save _As..." Command="{Binding SaveCaptureCommand}" InputGestureText="Ctrl+S"/>
                </MenuItem>
                <MenuItem Header="_Edit"/>
                <MenuItem Header="_View">
                    <MenuItem Header="No" IsCheckable="True" IsChecked="{Binding IsNoColumnVisible, Mode=TwoWay}"/>
                    <MenuItem Header="Time" IsCheckable="True" IsChecked="{Binding IsTimeColumnVisible, Mode=TwoWay}"/>
                    <MenuItem Header="Src" IsCheckable="True" IsChecked="{Binding IsSrcColumnVisible, Mode=TwoWay}"/>
                    <MenuItem Header="Dst" IsCheckable="True" IsChecked="{Binding IsDstColumnVisible, Mode=TwoWay}"/>
                    <MenuItem Header="Proto" IsCheckable="True" IsChecked="{Binding IsProtoColumnVisible, Mode=TwoWay}"/>
                    <MenuItem Header="SPort" IsCheckable="True" IsChecked="{Binding IsSPortColumnVisible, Mode=TwoWay}"/>
                    <MenuItem Header="DPort" IsCheckable="True" IsChecked="{Binding IsDPortColumnVisible, Mode=TwoWay}"/>
                    <MenuItem Header="Len" IsCheckable="True" IsChecked="{Binding IsLenColumnVisible, Mode=TwoWay}"/>
                    <MenuItem Header="Flags" IsCheckable="True" IsChecked="{Binding IsFlagsColumnVisible, Mode=TwoWay}"/>
                    <MenuItem Header="PID" IsCheckable="True" IsChecked="{Binding IsPidColumnVisible, Mode=TwoWay}"/>
                    <MenuItem Header="Process" IsCheckable="True" IsChecked="{Binding IsProcessColumnVisible, Mode=TwoWay}"/>
                    <MenuItem Header="Info" IsCheckable="True" IsChecked="{Binding IsInfoColumnVisible, Mode=TwoWay}"/>
                </MenuItem>
                <MenuItem Header="_Go"/>
                <MenuItem Header="_Capture"/>
                <MenuItem Header="_Analyze"/>
                <MenuItem Header="_Statistics" Command="{Binding OpenStatisticsCommand}"/>
            </Menu>
        </Border>

        <!-- ===== CAPTURE TOOLBAR ===== -->
        <Border DockPanel.Dock="Top" Background="#FFF7F7F7" BorderBrush="#FFD0D0D0" BorderThickness="0,0,0,1">
            <ToolBarTray Background="#FFF7F7F7" IsLocked="True">
                <ToolBar Background="#FFF7F7F7" BorderThickness="0" Padding="2" MinHeight="28">
                    <ToolBar.Resources>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Padding" Value="10,2"/>
                            <Setter Property="Margin" Value="2,0"/>
                            <Setter Property="MinHeight" Value="24"/>
                        </Style>
                        <Style TargetType="{x:Type TextBox}">
                            <Setter Property="Margin" Value="2,0"/>
                            <Setter Property="MinHeight" Value="24"/>
                        </Style>
                        <Style TargetType="{x:Type ComboBox}">
                            <Setter Property="Margin" Value="2,0"/>
                            <Setter Property="MinHeight" Value="24"/>
                        </Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Margin" Value="6,0,0,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </ToolBar.Resources>

                    <ComboBox Width="Auto"
                              Padding="0,0,26,0"
                              HorizontalContentAlignment="Left"
                              ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice}"
                              DisplayMemberPath="Name"/>

                    <Separator/>

                    <Button Content="▶️" Command="{Binding StartCommand}" />
                    <Button Content="⏸️"  Command="{Binding StopCommand}" />
                    <Button Content="Unfollow Flow"
                            Command="{Binding ClearFlowFilterCommand}"
                            Visibility="{Binding IsFlowFollowActive, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <Separator/>

                    <TextBlock Foreground="DarkOrange" Text="{Binding FiltersText}"/>

                    <Separator/>

                    <Button Content="Show Packets" Command="{Binding ShowPacketsCommand}" />
                    <Button Content="Show Flows" Command="{Binding ShowFlowsCommand}" />
                    <Button Content="Process Packets" Command="{Binding ShowProcessPacketsCommand}" />
                    <Button Content="🔍-" Command="{Binding ZoomOutPacketsCommand}" ToolTip="Зменшити масштаб" />
                    <Button Content="🔍+" Command="{Binding ZoomInPacketsCommand}" ToolTip="Збільшити масштаб" />
                    <Button Content="🔼" Command="{Binding SelectFirstPacketCommand}" ToolTip="Перший пакет" />
                    <Button Content="⏪" Command="{Binding SelectPreviousPacketCommand}" ToolTip="Попередній пакет" />
                    <Button Content="⏩" Command="{Binding SelectNextPacketCommand}" ToolTip="Наступний пакет" />
                    <Button Content="🔽" Command="{Binding SelectLastPacketCommand}" ToolTip="Останній пакет" />
                    
                </ToolBar>
            </ToolBarTray>
        </Border>

        <!-- ===== BPF FILTER (separate row under toolbar) ===== -->
        <Border DockPanel.Dock="Top" Background="#FFF7F7F7" BorderBrush="#FFD0D0D0" BorderThickness="0,0,0,1">
            <Grid Margin="4,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        Content="Filters..."
                        Command="{Binding OpenFiltersCommand}"
                        MinHeight="24"
                        Padding="10,2"
                        Margin="6,0,2,0"/>
                <TextBox Grid.Column="2"
                         Width="800"
                         MinHeight="24"
                         Text="{Binding BpfFilter}"
                         ToolTip="BPF filter (наприклад: tcp port 443)"/>
                
            </Grid>
        </Border>

        <!-- ===== BOTTOM STATUS BAR ===== -->
        <StatusBar DockPanel.Dock="Bottom"
                   Background="#FFF7F7F7"
                   BorderBrush="#FFD0D0D0"
                   BorderThickness="1,0,0,0"
                   Padding="4,1">
            <StatusBarItem HorizontalContentAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock FontWeight="SemiBold" Text="Capture:"/>
                        <Border Width="1" Height="14" Background="#FFD0D0D0" Margin="10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Stats.SummaryTotalPackets, StringFormat=Packets: {0:N0}}"/>
                        <Border Width="1" Height="14" Background="#FFD0D0D0" Margin="10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Stats.SummaryPacketsPerSec, StringFormat=Rate: {0}}"/>
                        <Border Width="1" Height="14" Background="#FFD0D0D0" Margin="10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Stats.SummaryTotalBytesHuman, StringFormat=Size: {0}}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               HorizontalAlignment="Right"
                               Margin="12,0,0,0"
                               Text="{Binding StatusText}"/>
                </Grid>
            </StatusBarItem>
        </StatusBar>

        <!-- ===== MAIN CONTENT (edge-to-edge) ===== -->
        <Grid Margin="0">
            <TabControl SelectedIndex="{Binding LeftTabIndex}" Margin="0" Padding="0">
                <TabControl.Template>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>

                <!-- Используем готовые UserControl'ы вместо дублирования -->
                <TabItem Header="Packets">
                    <views:PacketsView />
                </TabItem>

                <TabItem Header="Flows">
                    <views:FlowsView />
                </TabItem>

                <TabItem Header="Process Packets">
                    <views:ProcessPacketsView />
                </TabItem>


            </TabControl>
        </Grid>

    </DockPanel>
</Window>