<!-- MainWindow.xaml -->
<Window x:Class="Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:views="clr-namespace:Presentation.Views"
        xmlns:helpers="clr-namespace:Presentation.Helpers"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrafficMonitor"
        Icon="Images/Icon1024by1024.png"
        Height="720"
        Width="1280"
        MinHeight="680"
        MinWidth="1120">

    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style x:Key="CompactToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="IconToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI Emoji"/>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="O" Command="{Binding OpenCaptureCommand}" />
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveCaptureCommand}" />
        <KeyBinding Key="Right" Command="{Binding SelectFirstPacketCommand}" />
        <KeyBinding Key="Up" Command="{Binding SelectPreviousPacketCommand}" />
        <KeyBinding Key="Down" Command="{Binding SelectNextPacketCommand}" />
        <KeyBinding Key="Left" Command="{Binding SelectLastPacketCommand}" />
    </Window.InputBindings>

    <DockPanel LastChildFill="True" Margin="0" Background="{StaticResource AppBackgroundBrush}">

        <!-- ===== TOP MENU ===== -->
        <Border DockPanel.Dock="Top"
                Margin="8,8,8,0"
                Padding="2,0"
                Background="{StaticResource ShellBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="12">
            <Menu Padding="0" FontSize="11">
                <Menu.Resources>
                    <Style TargetType="{x:Type MenuItem}">
                        <Setter Property="Padding" Value="8,3"/>
                        <Setter Property="FontSize" Value="11"/>
                    </Style>
                </Menu.Resources>
                <MenuItem Header="_File">
                    <MenuItem Header="_Open..." Command="{Binding OpenCaptureCommand}" InputGestureText="Ctrl+O"/>
                    <MenuItem Header="Save _As..." Command="{Binding SaveCaptureCommand}" InputGestureText="Ctrl+S"/>
                    <Separator/>
                    <MenuItem Header="_Quit" Command="{Binding QuitApplicationCommand}"/>
                </MenuItem>
                <MenuItem Header="_View">
                    <MenuItem Header="No" IsCheckable="True" IsChecked="{Binding IsNoColumnVisible, Mode=TwoWay}"/>
                    <MenuItem Header="Time" IsCheckable="True" IsChecked="{Binding IsTimeColumnVisible, Mode=TwoWay}"/>
                    <MenuItem Header="Src" IsCheckable="True" IsChecked="{Binding IsSrcColumnVisible, Mode=TwoWay}"/>
                    <MenuItem Header="Dst" IsCheckable="True" IsChecked="{Binding IsDstColumnVisible, Mode=TwoWay}"/>
                    <MenuItem Header="Proto" IsCheckable="True" IsChecked="{Binding IsProtoColumnVisible, Mode=TwoWay}"/>
                    <MenuItem Header="SPort" IsCheckable="True" IsChecked="{Binding IsSPortColumnVisible, Mode=TwoWay}"/>
                    <MenuItem Header="DPort" IsCheckable="True" IsChecked="{Binding IsDPortColumnVisible, Mode=TwoWay}"/>
                    <MenuItem Header="Len" IsCheckable="True" IsChecked="{Binding IsLenColumnVisible, Mode=TwoWay}"/>
                    <MenuItem Header="Flags" IsCheckable="True" IsChecked="{Binding IsFlagsColumnVisible, Mode=TwoWay}"/>
                    <MenuItem Header="PID" IsCheckable="True" IsChecked="{Binding IsPidColumnVisible, Mode=TwoWay}"/>
                    <MenuItem Header="Process" IsCheckable="True" IsChecked="{Binding IsProcessColumnVisible, Mode=TwoWay}"/>
                    <MenuItem Header="Info" IsCheckable="True" IsChecked="{Binding IsInfoColumnVisible, Mode=TwoWay}"/>
                </MenuItem>
                <MenuItem Header="_Analyze">
                    <MenuItem Header="_Flows" Command="{Binding ShowFlowsCommand}" />
                    <MenuItem Header="_Hosts / Endpoints" Command="{Binding ShowEndpointsCommand}" />
                    <MenuItem Header="_History" Command="{Binding ShowHistoryCommand}" />
                    <MenuItem Header="_Statistics" Command="{Binding OpenStatisticsCommand}" />
                </MenuItem>
                <MenuItem Header="_Settings">
                    <MenuItem Header="_Notifications..." Command="{Binding OpenNotificationSettingsCommand}" />
                </MenuItem>
                <MenuItem Header="_Guide"></MenuItem>
            </Menu>
        </Border>

        <!-- ===== CAPTURE TOOLBAR ===== -->
        <Border DockPanel.Dock="Top"
                Margin="8,8,8,0"
                Padding="6,4"
                Background="{StaticResource CaptureToolbarBackgroundBrush}"
                BorderBrush="{StaticResource CaptureToolbarBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <ToolBarTray IsLocked="True">
                <ToolBar Padding="0" MinHeight="26">
                    <ToolBar.Resources>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource CompactToolbarButtonStyle}">
                            <Setter Property="Margin" Value="0,0,6,0"/>
                        </Style>
                        <Style TargetType="{x:Type TextBox}">
                            <Setter Property="Margin" Value="0,0,6,0"/>
                            <Setter Property="MinHeight" Value="26"/>
                        </Style>
                        <Style TargetType="{x:Type ComboBox}">
                            <Setter Property="Margin" Value="0,0,6,0"/>
                            <Setter Property="MinWidth" Value="220"/>
                            <Setter Property="MinHeight" Value="26"/>
                        </Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Margin" Value="6,0,0,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FontSize" Value="11"/>
                        </Style>
                    </ToolBar.Resources>

                    <ComboBox Width="Auto"
                              Padding="0,0,26,0"
                              HorizontalContentAlignment="Left"
                              ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice}"
                              DisplayMemberPath="Name"/>



                    <Separator/>

                    <Button Content="Start" Command="{Binding StartCommand}" Style="{StaticResource IconToolbarButtonStyle}"/>
                    <Button Content="Stop" Command="{Binding StopCommand}" Style="{StaticResource IconToolbarButtonStyle}" />
                    <Button Content="Unfollow Flow"
                            Command="{Binding ClearFlowFilterCommand}"
                            Visibility="{Binding IsFlowFollowActive, Converter={StaticResource BoolToVisibilityConverter}}"
                            Style="{StaticResource IconToolbarButtonStyle}"/>

                    <Separator/>

                    <Button Content="DataGrid" Command="{Binding ShowPacketsCommand}" ToolTip="Show Packets" Style="{StaticResource IconToolbarButtonStyle}"/>
                    <Button Content="Processes"
                            Command="{Binding ShowProcessPacketsCommand}"
                            Style="{StaticResource CompactToolbarButtonStyle}" />

                    <Separator/>
                    
                    <Button Content="🔍−" Command="{Binding ZoomOutPacketsCommand}" ToolTip="Zoom out" Style="{StaticResource IconToolbarButtonStyle}" />
                    <Button Content="🔍+" Command="{Binding ZoomInPacketsCommand}" ToolTip="Zoom in" Style="{StaticResource IconToolbarButtonStyle}" />
                    <Button Content="⏮" Command="{Binding SelectFirstPacketCommand}" ToolTip="First packet" Style="{StaticResource IconToolbarButtonStyle}" />
                    <Button Content="◀" Command="{Binding SelectPreviousPacketCommand}" ToolTip="Previous packet" Style="{StaticResource IconToolbarButtonStyle}" />
                    <Button Content="▶" Command="{Binding SelectNextPacketCommand}" ToolTip="Next packet" Style="{StaticResource IconToolbarButtonStyle}" />
                    <Button Content="⏭" Command="{Binding SelectLastPacketCommand}" ToolTip="Last packet" Style="{StaticResource IconToolbarButtonStyle}" />
                    
                    <Separator/>
                    
                    <Button Content="📂"
                        Command="{Binding OpenCaptureCommand}"
                        ToolTip="Import capture file (Ctrl+O)"
                        Style="{StaticResource IconToolbarButtonStyle}" />
                    <Button Content="🗂️"
                        Command="{Binding SaveCaptureCommand}"
                        ToolTip="Save capture file (Ctrl+S)"
                        Style="{StaticResource IconToolbarButtonStyle}" />

                </ToolBar>
            </ToolBarTray>
        </Border>

        <!-- ===== BOTTOM STATUS BAR ===== -->
        <StatusBar DockPanel.Dock="Bottom"
                   Margin="8,8,8,8"
                   Padding="2,0">
            <StatusBarItem HorizontalContentAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock FontWeight="SemiBold" Text="Capture:"/>
                        <Border Width="1" Height="14" Background="{StaticResource BorderBrushSoft}" Margin="10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Stats.SummaryTotalPackets, StringFormat=Packets: {0:N0}}"/>
                        <Border Width="1" Height="14" Background="{StaticResource BorderBrushSoft}" Margin="10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Stats.SummaryPacketsPerSec, StringFormat=Rate: {0}}"/>
                        <Border Width="1" Height="14" Background="{StaticResource BorderBrushSoft}" Margin="10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Stats.SummaryTotalBytesHuman, StringFormat=Size: {0}}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               HorizontalAlignment="Right"
                               Margin="12,0,0,0"
                               Text="{Binding StatusText}"/>
                </Grid>
            </StatusBarItem>
        </StatusBar>

        <!-- ===== MAIN CONTENT (edge-to-edge) ===== -->
        <Grid Margin="8,8,8,0">
            <TabControl SelectedIndex="{Binding LeftTabIndex}" Margin="0" Padding="0">
                <TabControl.Template>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>

                <TabItem Header="Packets">
                    <views:PacketsView />
                </TabItem>

                <TabItem Header="Flows">
                    <views:FlowsView />
                </TabItem>

                <TabItem Header="Endpoints">
                    <views:EndpointsView DataContext="{Binding Endpoints}" />
                </TabItem>

                <TabItem Header="History">
                    <views:HistoryView DataContext="{Binding History}" />
                </TabItem>

                <TabItem Header="Process Packets">
                    <views:ProcessPacketsView />
                </TabItem>

                <TabItem Header="Statistics">
                    <views:StatsView DataContext="{Binding Stats}" />
                </TabItem>


            </TabControl>
        </Grid>

    </DockPanel>
</Window>
