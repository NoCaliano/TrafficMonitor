<!-- MainWindow.xaml -->
<Window x:Class="Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:views="clr-namespace:Presentation.Views"
        xmlns:helpers="clr-namespace:Presentation.Helpers"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrafficMonitor"
        Height="720"
        Width="1280"
        MinHeight="680"
        MinWidth="1120">

    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style x:Key="CompactToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="IconToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI Emoji"/>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="O" Command="{Binding OpenCaptureCommand}" />
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveCaptureCommand}" />
    </Window.InputBindings>

    <DockPanel LastChildFill="True" Margin="0" Background="{StaticResource AppBackgroundBrush}">

        <!-- ===== TOP MENU ===== -->
        <Border DockPanel.Dock="Top"
                Margin="8,8,8,0"
                Padding="4,1"
                Background="{StaticResource ShellBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="12">
            <Menu Padding="0" FontSize="12">
                <MenuItem Header="_File">
                    <MenuItem Header="_Open..." Command="{Binding OpenCaptureCommand}" InputGestureText="Ctrl+O"/>
                    <MenuItem Header="Save _As..." Command="{Binding SaveCaptureCommand}" InputGestureText="Ctrl+S"/>
                </MenuItem>
                <MenuItem Header="_Edit"/>
                <MenuItem Header="_View">
                    <MenuItem Header="No" IsCheckable="True" IsChecked="{Binding IsNoColumnVisible, Mode=TwoWay}"/>
                    <MenuItem Header="Time" IsCheckable="True" IsChecked="{Binding IsTimeColumnVisible, Mode=TwoWay}"/>
                    <MenuItem Header="Src" IsCheckable="True" IsChecked="{Binding IsSrcColumnVisible, Mode=TwoWay}"/>
                    <MenuItem Header="Dst" IsCheckable="True" IsChecked="{Binding IsDstColumnVisible, Mode=TwoWay}"/>
                    <MenuItem Header="Proto" IsCheckable="True" IsChecked="{Binding IsProtoColumnVisible, Mode=TwoWay}"/>
                    <MenuItem Header="SPort" IsCheckable="True" IsChecked="{Binding IsSPortColumnVisible, Mode=TwoWay}"/>
                    <MenuItem Header="DPort" IsCheckable="True" IsChecked="{Binding IsDPortColumnVisible, Mode=TwoWay}"/>
                    <MenuItem Header="Len" IsCheckable="True" IsChecked="{Binding IsLenColumnVisible, Mode=TwoWay}"/>
                    <MenuItem Header="Flags" IsCheckable="True" IsChecked="{Binding IsFlagsColumnVisible, Mode=TwoWay}"/>
                    <MenuItem Header="PID" IsCheckable="True" IsChecked="{Binding IsPidColumnVisible, Mode=TwoWay}"/>
                    <MenuItem Header="Process" IsCheckable="True" IsChecked="{Binding IsProcessColumnVisible, Mode=TwoWay}"/>
                    <MenuItem Header="Info" IsCheckable="True" IsChecked="{Binding IsInfoColumnVisible, Mode=TwoWay}"/>
                </MenuItem>
                <MenuItem Header="_Go"/>
                <MenuItem Header="_Capture"/>
                <MenuItem Header="_Analyze"/>
                <MenuItem Header="_Statistics" Command="{Binding OpenStatisticsCommand}"/>
            </Menu>
        </Border>

        <!-- ===== CAPTURE TOOLBAR ===== -->
        <Border DockPanel.Dock="Top"
                Margin="8,8,8,0"
                Padding="8"
                Background="{StaticResource ShellBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="12">
            <ToolBarTray IsLocked="True">
                <ToolBar Padding="0" MinHeight="30">
                    <ToolBar.Resources>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource CompactToolbarButtonStyle}">
                            <Setter Property="Margin" Value="0,0,6,0"/>
                        </Style>
                        <Style TargetType="{x:Type TextBox}">
                            <Setter Property="Margin" Value="0,0,6,0"/>
                            <Setter Property="MinHeight" Value="30"/>
                        </Style>
                        <Style TargetType="{x:Type ComboBox}">
                            <Setter Property="Margin" Value="0,0,6,0"/>
                            <Setter Property="MinWidth" Value="220"/>
                            <Setter Property="MinHeight" Value="30"/>
                        </Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Margin" Value="6,0,0,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FontSize" Value="12"/>
                        </Style>
                    </ToolBar.Resources>

                    <ComboBox Width="Auto"
                              Padding="0,0,26,0"
                              HorizontalContentAlignment="Left"
                              ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice}"
                              DisplayMemberPath="Name"/>

                    <Separator/>

                    <Button Content="Start" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="10,5"/>
                    <Button Content="Stop" Command="{Binding StopCommand}" />
                    <Button Content="Unfollow Flow"
                            Command="{Binding ClearFlowFilterCommand}"
                            Visibility="{Binding IsFlowFollowActive, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <Separator/>

                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding FiltersText}"/>

                    <Separator/>

                    <Button Content="Show Packets" Command="{Binding ShowPacketsCommand}" />
                    <Button Content="Show Flows" Command="{Binding ShowFlowsCommand}" />
                    <Button Content="Process Packets" Command="{Binding ShowProcessPacketsCommand}" />
                    <Button Content="🔍−" Command="{Binding ZoomOutPacketsCommand}" ToolTip="Зменшити масштаб" Style="{StaticResource IconToolbarButtonStyle}" />
                    <Button Content="🔍+" Command="{Binding ZoomInPacketsCommand}" ToolTip="Збільшити масштаб" Style="{StaticResource IconToolbarButtonStyle}" />
                    <Button Content="⏮" Command="{Binding SelectFirstPacketCommand}" ToolTip="Перший пакет" Style="{StaticResource IconToolbarButtonStyle}" />
                    <Button Content="◀" Command="{Binding SelectPreviousPacketCommand}" ToolTip="Попередній пакет" Style="{StaticResource IconToolbarButtonStyle}" />
                    <Button Content="▶" Command="{Binding SelectNextPacketCommand}" ToolTip="Наступний пакет" Style="{StaticResource IconToolbarButtonStyle}" />
                    <Button Content="⏭" Command="{Binding SelectLastPacketCommand}" ToolTip="Останній пакет" Style="{StaticResource IconToolbarButtonStyle}" />
                    
                </ToolBar>
            </ToolBarTray>
        </Border>

        <!-- ===== BPF FILTER (separate row under toolbar) ===== -->
        <Border DockPanel.Dock="Top"
                Margin="8,8,8,0"
                Padding="8"
                Background="{StaticResource ShellBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Style="{StaticResource SectionCaptionTextStyle}"
                           Text="Capture filter"/>

                <Button Grid.Column="2"
                        Content="Filters..."
                        Command="{Binding OpenFiltersCommand}"
                        Style="{StaticResource CompactToolbarButtonStyle}"/>
                <TextBox Grid.Column="4"
                         Text="{Binding BpfFilter}"
                         ToolTip="BPF filter (наприклад: tcp port 443)"/>
                
            </Grid>
        </Border>

        <!-- ===== BOTTOM STATUS BAR ===== -->
        <StatusBar DockPanel.Dock="Bottom"
                   Margin="8,8,8,8"
                   Padding="2,0">
            <StatusBarItem HorizontalContentAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock FontWeight="SemiBold" Text="Capture:"/>
                        <Border Width="1" Height="14" Background="{StaticResource BorderBrushSoft}" Margin="10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Stats.SummaryTotalPackets, StringFormat=Packets: {0:N0}}"/>
                        <Border Width="1" Height="14" Background="{StaticResource BorderBrushSoft}" Margin="10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Stats.SummaryPacketsPerSec, StringFormat=Rate: {0}}"/>
                        <Border Width="1" Height="14" Background="{StaticResource BorderBrushSoft}" Margin="10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Stats.SummaryTotalBytesHuman, StringFormat=Size: {0}}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               HorizontalAlignment="Right"
                               Margin="12,0,0,0"
                               Text="{Binding StatusText}"/>
                </Grid>
            </StatusBarItem>
        </StatusBar>

        <!-- ===== MAIN CONTENT (edge-to-edge) ===== -->
        <Grid Margin="8,8,8,0">
            <TabControl SelectedIndex="{Binding LeftTabIndex}" Margin="0" Padding="0">
                <TabControl.Template>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>

                <!-- Используем готовые UserControl'ы вместо дублирования -->
                <TabItem Header="Packets">
                    <views:PacketsView />
                </TabItem>

                <TabItem Header="Flows">
                    <views:FlowsView />
                </TabItem>

                <TabItem Header="Process Packets">
                    <views:ProcessPacketsView />
                </TabItem>


            </TabControl>
        </Grid>

    </DockPanel>
</Window>
