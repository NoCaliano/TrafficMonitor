<!-- MainWindow.xaml -->
<Window x:Class="Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:views="clr-namespace:Presentation.Views"
        xmlns:helpers="clr-namespace:Presentation.Helpers"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrafficMonitor"
        Height="650"
        Width="1200">

    <DockPanel LastChildFill="True" Margin="0">

        <!-- ===== TOP MENU ===== -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#FFD0D0D0" BorderThickness="0,0,0,1">
            <Menu Background="White" BorderThickness="0" Padding="2,0" FontSize="12">
                <Menu.Resources>
                    <Style TargetType="{x:Type MenuItem}">
                        <Setter Property="Padding" Value="8,2"/>
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </Menu.Resources>

                <MenuItem Header="_File"/>
                <MenuItem Header="_Edit"/>
                <MenuItem Header="_View"/>
                <MenuItem Header="_Go"/>
                <MenuItem Header="_Capture"/>
                <MenuItem Header="_Analyze"/>
                <MenuItem Header="_Statistics" Command="{Binding OpenStatisticsCommand}"/>
            </Menu>
        </Border>

        <!-- ===== CAPTURE TOOLBAR ===== -->
        <Border DockPanel.Dock="Top" Background="#FFF7F7F7" BorderBrush="#FFD0D0D0" BorderThickness="0,0,0,1">
            <ToolBarTray Background="#FFF7F7F7" IsLocked="True">
                <ToolBar Background="#FFF7F7F7" BorderThickness="0" Padding="2" MinHeight="28">
                    <ToolBar.Resources>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Padding" Value="10,2"/>
                            <Setter Property="Margin" Value="2,0"/>
                            <Setter Property="MinHeight" Value="24"/>
                        </Style>
                        <Style TargetType="{x:Type TextBox}">
                            <Setter Property="Margin" Value="2,0"/>
                            <Setter Property="MinHeight" Value="24"/>
                        </Style>
                        <Style TargetType="{x:Type ComboBox}">
                            <Setter Property="Margin" Value="2,0"/>
                            <Setter Property="MinHeight" Value="24"/>
                        </Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Margin" Value="6,0,0,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </ToolBar.Resources>

                    <ComboBox Width="Auto"
                              Padding="0,0,26,0"
                              HorizontalContentAlignment="Left"
                              ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice}"
                              DisplayMemberPath="Name"/>

                    <TextBox Width="320"
                             Text="{Binding BpfFilter}"
                             ToolTip="BPF filter (наприклад: tcp port 443)"/>

                    <Separator/>

                    <Button Content="Start" Command="{Binding StartCommand}" />
                    <Button Content="Stop"  Command="{Binding StopCommand}" />
                    <Button Content="Filters..." Command="{Binding OpenFiltersCommand}" />
                    <Button Content="Clear Filter" Command="{Binding ClearFlowFilterCommand}" />

                    <Separator/>

                    <TextBlock Text="{Binding StatusText}"/>
                    <TextBlock Foreground="DarkOrange" Text="{Binding FiltersText}"/>

                    <Separator/>

                    <Button Content="Show Packets" Command="{Binding ShowPacketsCommand}" />
                    <Button Content="Show Flows" Command="{Binding ShowFlowsCommand}" />
                </ToolBar>
            </ToolBarTray>
        </Border>

        <!-- ===== BOTTOM STATUS BAR ===== -->
        <StatusBar DockPanel.Dock="Bottom"
                   Background="#FFF7F7F7"
                   BorderBrush="#FFD0D0D0"
                   BorderThickness="1,0,0,0"
                   Padding="4,1">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontWeight="SemiBold" Text="Capture:"/>
                    <TextBlock Margin="8,0,0,0" Text="{Binding Stats.SummaryTotalPackets, StringFormat=Packets: {0:N0}}"/>
                    <TextBlock Margin="12,0,0,0" Text="{Binding Stats.SummaryPacketsPerSec, StringFormat=Rate: {0}}"/>
                    <TextBlock Margin="12,0,0,0" Text="{Binding Stats.SummaryTotalBytesHuman, StringFormat=Size: {0}}"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- ===== MAIN CONTENT (edge-to-edge) ===== -->
        <Grid Margin="0">
            <TabControl SelectedIndex="{Binding LeftTabIndex}" Margin="0" Padding="0">
                <TabControl.Template>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>

                <!-- Используем готовые UserControl'ы вместо дублирования -->
                <TabItem Header="Packets">
                    <views:PacketsView />
                </TabItem>

                <TabItem Header="Flows">
                    <views:FlowsView />
                </TabItem>

            </TabControl>
        </Grid>

    </DockPanel>
</Window>